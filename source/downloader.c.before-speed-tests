static char *duplicate_string(
    const char *text
)
{
    size_t len =
        strlen(text);

    char *copy =
        malloc(
            len + 1
        );

    if (!copy)
        return NULL;

    memcpy(
        copy,
        text,
        len + 1
    );

    return copy;
}


static void append_log(
    const char *path,
    const char *url,
    const char *message
)
{
    FILE *f =
        fopen(
            path,
            "a"
