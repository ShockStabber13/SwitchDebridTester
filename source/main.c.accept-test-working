#include <switch.h>

#include <arpa/inet.h>
#include <errno.h>
#include <netinet/in.h>
#include <stdio.h>
#include <string.h>
#include <sys/select.h>
#include <sys/socket.h>
#include <unistd.h>

#define PORT 8090

static int send_all(
    int fd,
    const void *buffer,
    size_t length
)
{
    const char *p = buffer;

    while (length > 0) {
        ssize_t n =
            send(fd, p, length, 0);

        if (n <= 0)
            return -1;

        p += n;
        length -= (size_t)n;
    }

    return 0;
}

int main(int argc, char **argv)
{
    (void)argc;
    (void)argv;

    consoleInit(NULL);

    padConfigureInput(
        1,
        HidNpadStyleSet_NpadStandard
    );

    PadState pad;
    padInitializeDefault(&pad);

    printf(
        "Switch Debrid Downloader\n"
        "Accept-loop diagnostic\n\n"
    );

    Result rc = socketInitializeDefault();

    if (R_FAILED(rc)) {
        printf(
            "socketInitializeDefault FAILED: 0x%08X\n",
            rc
        );

        while (appletMainLoop()) {
            padUpdate(&pad);
            consoleUpdate(NULL);

            if (
                padGetButtonsDown(&pad) &
                HidNpadButton_Plus
            )
                break;
        }

        consoleExit(NULL);
        return 0;
    }

    int server =
        socket(
            AF_INET,
            SOCK_STREAM,
            0
        );

    if (server < 0) {
        printf("socket FAILED: %d\n", errno);
        consoleUpdate(NULL);

        while (appletMainLoop()) {
            padUpdate(&pad);

            if (
                padGetButtonsDown(&pad) &
                HidNpadButton_Plus
            )
                break;
        }

        socketExit();
        consoleExit(NULL);
        return 0;
    }

    int yes = 1;

    setsockopt(
        server,
        SOL_SOCKET,
        SO_REUSEADDR,
        &yes,
        sizeof(yes)
    );

    struct sockaddr_in addr;

    memset(&addr, 0, sizeof(addr));

    addr.sin_family = AF_INET;
    addr.sin_port = htons(PORT);
    addr.sin_addr.s_addr = INADDR_ANY;

    if (
        bind(
            server,
            (struct sockaddr *)&addr,
            sizeof(addr)
        ) != 0
    ) {
        printf("bind FAILED: %d\n", errno);
        consoleUpdate(NULL);

        while (appletMainLoop()) {
            padUpdate(&pad);

            if (
                padGetButtonsDown(&pad) &
                HidNpadButton_Plus
            )
                break;
        }

        close(server);
        socketExit();
        consoleExit(NULL);
        return 0;
    }

    if (
        listen(
            server,
            8
        ) != 0
    ) {
        printf("listen FAILED: %d\n", errno);
        consoleUpdate(NULL);

        while (appletMainLoop()) {
            padUpdate(&pad);

            if (
                padGetButtonsDown(&pad) &
                HidNpadButton_Plus
            )
                break;
        }

        close(server);
        socketExit();
        consoleExit(NULL);
        return 0;
    }

    printf(
        "SERVER READY\n\n"
        "Open on phone:\n"
        "http://SWITCH-IP:%d\n\n"
        "Press + to exit.\n",
        PORT
    );

    consoleUpdate(NULL);

    while (appletMainLoop()) {
        padUpdate(&pad);

        if (
            padGetButtonsDown(&pad) &
            HidNpadButton_Plus
        ) {
            break;
        }

        fd_set readfds;

        FD_ZERO(&readfds);
        FD_SET(server, &readfds);

        struct timeval timeout;

        timeout.tv_sec = 0;
        timeout.tv_usec = 100000;

        int ready =
            select(
                server + 1,
                &readfds,
                NULL,
                NULL,
                &timeout
            );

        if (ready < 0) {
            printf(
                "\nselect FAILED: %d\n",
                errno
            );

            consoleUpdate(NULL);
            continue;
        }

        if (
            ready > 0 &&
            FD_ISSET(server, &readfds)
        ) {
            int client =
                accept(
                    server,
                    NULL,
                    NULL
                );

            if (client >= 0) {
                char request[2048];

                recv(
                    client,
                    request,
                    sizeof(request),
                    0
                );

                const char body[] =
                    "<html><body>"
                    "<h2>Switch server works!</h2>"
                    "</body></html>";

                char header[256];

                int n =
                    snprintf(
                        header,
                        sizeof(header),
                        "HTTP/1.1 200 OK\r\n"
                        "Content-Type: text/html\r\n"
                        "Content-Length: %zu\r\n"
                        "Connection: close\r\n"
                        "\r\n",
                        strlen(body)
                    );

                send_all(
                    client,
                    header,
                    (size_t)n
                );

                send_all(
                    client,
                    body,
                    strlen(body)
                );

                close(client);

                printf(
                    "\nPhone request served successfully.\n"
                );

                consoleUpdate(NULL);
            }
        }
    }

    close(server);
    socketExit();
    consoleExit(NULL);

    return 0;
}
