static size_t api_write(
    char *ptr,
    size_t size,
    size_t nmemb,
    void *userdata
)
{
    ApiBuffer *buffer =
        (ApiBuffer *)userdata;

    size_t amount =
        size * nmemb;

    if (
        buffer->size +
        amount +
        1 >
        buffer->capacity
    ) {
        buffer->overflow =
            true;

        return 0;
    }

    memcpy(
        buffer->data +
        buffer->size,
        ptr,
        amount
    );

    buffer->size += amount;

    buffer->data[
        buffer->size
    ] = '\0';

    return amount;
}


