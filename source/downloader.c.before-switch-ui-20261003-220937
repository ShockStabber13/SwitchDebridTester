static char *duplicate_string(
    const char *text
)
{
    size_t len =
        strlen(text);

    char *copy =
        malloc(
            len + 1
        );

    if (!copy)
        return NULL;

    memcpy(
        copy,
        text,
        len + 1
    );

    return copy;
}


