static struct curl_slist *
make_auth_headers(void)
{
    char auth[1200];

    snprintf(
        auth,
        sizeof(auth),
        "Authorization: Bearer %s",
        g_token
    );

    struct curl_slist *headers =
        NULL;

    headers =
        curl_slist_append(
            headers,
            auth
        );

    headers =
        curl_slist_append(
            headers,
            "Content-Type: application/x-www-form-urlencoded"
        );

    return headers;
}


static bool form_encode(
    const char *input,
    char **output
)
{
    size_t input_len =
        strlen(input);

    size_t capacity =
        input_len * 3 +
        1;

    char *encoded =
        malloc(capacity);

    if (!encoded)
        return false;

    static const char hex[] =
        "0123456789ABCDEF";

    size_t out = 0;

    for (
        size_t i = 0;
        i < input_len;
        i++
    ) {
        unsigned char c =
            (unsigned char)input[i];

        if (
            isalnum(c) ||
            c == '-' ||
            c == '_' ||
            c == '.' ||
            c == '~'
        ) {
            encoded[out++] =
                (char)c;
        }
        else {
            encoded[out++] = '%';
            encoded[out++] =
                hex[
                    (c >> 4) &
                    0xF
                ];

            encoded[out++] =
                hex[
                    c & 0xF
                ];
        }
    }

    encoded[out] = '\0';

    *output = encoded;

    return true;
}


static bool api_post(
    const char *endpoint,
    const char *post_data,
    char *response,
    size_t response_size,
    long *http_status
)
{
    CURL *curl =
        curl_easy_init();

    if (!curl)
        return false;

    ApiBuffer buffer = {
        .data = response,
        .size = 0,
        .capacity = response_size,
        .overflow = false
    };

    response[0] = '\0';

    struct curl_slist *headers =
        make_auth_headers();

    curl_easy_setopt(
        curl,
        CURLOPT_URL,
        endpoint
    );

    curl_easy_setopt(
        curl,
        CURLOPT_HTTPHEADER,
        headers
    );

    curl_easy_setopt(
        curl,
        CURLOPT_POST,
        1L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_POSTFIELDS,
        post_data
    );

    curl_easy_setopt(
        curl,
        CURLOPT_WRITEFUNCTION,
        api_write
    );

    curl_easy_setopt(
        curl,
        CURLOPT_WRITEDATA,
        &buffer
    );

    configure_common_curl(
        curl
    );

    CURLcode rc =
        curl_easy_perform(
            curl
        );

    *http_status = 0;

    curl_easy_getinfo(
        curl,
        CURLINFO_RESPONSE_CODE,
        http_status
    );

    curl_easy_cleanup(
        curl
    );

    if (headers)
        curl_slist_free_all(
            headers
        );

    return
        rc == CURLE_OK &&
        !buffer.overflow;
}


/* ========================================================= */
/* AllDebrid unlock + delayed flow                           */
/* ========================================================= */

static bool poll_delayed(
    unsigned long long delayed_id,
    char *direct_url,
    size_t direct_url_size,
    char *error,
    size_t error_size
)
{
    char *response =
        malloc(
            API_BODY_MAX
        );

    if (!response) {
        snprintf(
            error,
            error_size,
            "Out of memory"
        );

        return false;
    }

    for (
        int attempt = 0;
        attempt < 60 &&
        g_running;
        attempt++
    ) {
        /*
         * AllDebrid requests at least five seconds
         * between delayed-link status checks.
         */
        svcSleepThread(
            5LL *
            1000LL *
            1000LL *
            1000LL
        );

        char post_data[128];

        snprintf(
            post_data,
            sizeof(post_data),
            "id=%llu",
            delayed_id
        );

        long status = 0;

        bool request_ok =
            api_post(
                "https://api.alldebrid.com/v4/link/delayed",
                post_data,
                response,
                API_BODY_MAX,
                &status
            );

        if (
            !request_ok ||
            status != 200 ||
            !api_success(response)
        ) {
            snprintf(
                error,
                error_size,
                "Delayed-link API error"
            );

            free(response);
            return false;
        }

        const char *data =
            strstr(
                response,
                "\"data\""
            );

        if (!data)
            data = response;

        unsigned long long
            delayed_status = 0;

        if (
            !json_u64(
                data,
                "status",
                &delayed_status
            )
        ) {
            snprintf(
                error,
                error_size,
                "Invalid delayed-link response"
            );

            free(response);
            return false;
        }

        if (
            delayed_status == 2
        ) {
            bool found =
                json_string(
                    data,
                    "link",
                    direct_url,
                    direct_url_size
                );

            free(response);

            if (
                !found ||
                !direct_url[0]
            ) {
                snprintf(
                    error,
                    error_size,
                    "Delayed link ready but URL missing"
                );

                return false;
            }

            return true;
        }

        if (
            delayed_status == 3
        ) {
            snprintf(
                error,
                error_size,
                "AllDebrid could not generate link"
            );

            free(response);
            return false;
        }
    }

    free(response);

    snprintf(
        error,
        error_size,
        "Delayed-link timeout"
    );

    return false;
}


static bool unlock_link(
    const char *source_url,
    UnlockResult *result
)
{
    memset(
        result,
        0,
        sizeof(*result)
    );

    char *encoded = NULL;

    if (
        !form_encode(
            source_url,
            &encoded
        )
    ) {
        snprintf(
            result->error,
            sizeof(result->error),
            "Could not encode source URL"
        );

        return false;
    }

    size_t post_size =
        strlen(encoded) +
        16;

    char *post_data =
        malloc(
            post_size
        );

    if (!post_data) {
        free(encoded);

        snprintf(
            result->error,
            sizeof(result->error),
            "Out of memory"
        );

        return false;
    }

    snprintf(
        post_data,
        post_size,
        "link=%s",
        encoded
    );

    free(encoded);

    char *response =
        malloc(
            API_BODY_MAX
        );

    if (!response) {
        free(post_data);

        snprintf(
            result->error,
            sizeof(result->error),
            "Out of memory"
        );

        return false;
    }

    long status = 0;

    bool request_ok =
        api_post(
            "https://api.alldebrid.com/v4/link/unlock",
            post_data,
            response,
            API_BODY_MAX,
            &status
        );

    free(post_data);

    if (
        !request_ok ||
        status != 200 ||
        !api_success(response)
    ) {
        char code[128] = {0};
        char message[256] = {0};

        json_string(
            response,
            "code",
            code,
            sizeof(code)
        );

        json_string(
            response,
            "message",
            message,
            sizeof(message)
        );

        snprintf(
            result->error,
            sizeof(result->error),
            "%s%s%s",
            code[0]
                ? code
                : "Unlock failed",
            message[0]
                ? ": "
                : "",
            message
        );

        free(response);

        return false;
    }

    const char *data =
        strstr(
            response,
            "\"data\""
        );

    if (!data)
        data = response;

    json_string(
        data,
        "filename",
        result->filename,
        sizeof(result->filename)
    );

    json_u64(
        data,
        "filesize",
        &result->filesize
    );

    if (
        json_string(
            data,
            "link",
            result->direct_url,
            sizeof(result->direct_url)
        ) &&
        result->direct_url[0]
    ) {
        result->success = true;

        free(response);

        return true;
    }

    json_u64(
        data,
        "delayed",
        &result->delayed
    );

    free(response);

    if (
        result->delayed > 0
    ) {
        if (
            poll_delayed(
                result->delayed,
                result->direct_url,
                sizeof(result->direct_url),
                result->error,
                sizeof(result->error)
            )
        ) {
            result->success = true;
            return true;
        }

        return false;
    }

    snprintf(
        result->error,
        sizeof(result->error),
        "No download URL returned"
    );

    return false;
}


