void downloader_get_curl_runtime_info(
    char *version,
    size_t version_size,
    char *ssl,
    size_t ssl_size,
    bool *http2_supported
)
{
    if (
        version &&
        version_size > 0
    ) {
        version[0] = '\0';
    }

    if (
        ssl &&
        ssl_size > 0
    ) {
        ssl[0] = '\0';
    }

    if (http2_supported)
        *http2_supported = false;

    const curl_version_info_data *info =
        curl_version_info(
            CURLVERSION_NOW
        );

    if (!info)
        return;

    if (
        version &&
        version_size > 0
    ) {
        snprintf(
            version,
            version_size,
            "%s",
            info->version
                ? info->version
                : "unknown"
        );
    }

    if (
        ssl &&
        ssl_size > 0
    ) {
        snprintf(
            ssl,
            ssl_size,
            "%s",
            info->ssl_version
                ? info->ssl_version
                : "none/unknown"
        );
    }

    if (http2_supported) {
        *http2_supported =
            (
                info->features &
                CURL_VERSION_HTTP2
            ) != 0;
    }
}


bool downloader_debug_network(
    const char *source_url,
    double *mb_per_second,
    unsigned long long *bytes_tested,
    char *error,
    size_t error_size
)
{
    if (mb_per_second)
        *mb_per_second = 0.0;

    if (bytes_tested)
        *bytes_tested = 0;

    DownloaderStats stats;

    downloader_get_stats(
        &stats
    );

    if (
        stats.active > 0 ||
        stats.queued > 0
    ) {
        snprintf(
            error,
            error_size,
            "Stop/wait for normal downloads before running diagnostics."
        );

        return false;
    }

    if (!g_token[0]) {
        snprintf(
            error,
            error_size,
            "AllDebrid is not connected."
        );

        return false;
    }

    UnlockResult unlock;

    if (
        !unlock_link(
            source_url,
            &unlock
        )
    ) {
        snprintf(
            error,
            error_size,
            "Unlock failed: %s",
            unlock.error[0]
                ? unlock.error
                : "unknown error"
        );

        return false;
    }

    CURL *curl =
        curl_easy_init();

    if (!curl) {
        snprintf(
            error,
            error_size,
            "curl_easy_init failed."
        );

        return false;
    }

    /*
     * About 64 MiB is enough for a useful sustained-speed test.
     */
    NetworkDiagContext ctx = {
        .bytes = 0,
        .limit =
            8ULL *
            1024ULL *
            1024ULL
    };

    curl_easy_setopt(
        curl,
        CURLOPT_URL,
        unlock.direct_url
    );

    curl_easy_setopt(
        curl,
        CURLOPT_FOLLOWLOCATION,
        1L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_MAXREDIRS,
        10L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_RANGE,
        "0-8388607"
    );

    curl_easy_setopt(
        curl,
        CURLOPT_WRITEFUNCTION,
        network_diag_write
    );

    curl_easy_setopt(
        curl,
        CURLOPT_WRITEDATA,
        &ctx
    );

    curl_easy_setopt(
        curl,
        CURLOPT_XFERINFOFUNCTION,
        network_diag_progress
    );

    curl_easy_setopt(
        curl,
        CURLOPT_XFERINFODATA,
        &ctx
    );

    curl_easy_setopt(
        curl,
        CURLOPT_NOPROGRESS,
        0L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_CONNECTTIMEOUT,
        30L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_TIMEOUT,
        0L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_NOSIGNAL,
        1L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_SSL_VERIFYPEER,
        1L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_SSL_VERIFYHOST,
        2L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_HTTP_VERSION,
        CURL_HTTP_VERSION_1_1
    );

    curl_easy_setopt(
        curl,
        CURLOPT_USERAGENT,
        g_user_agent[0]
            ? g_user_agent
            : "SwitchDebridDownloader"
    );

    struct timespec start;
    struct timespec end;

    clock_gettime(
        CLOCK_MONOTONIC,
        &start
    );

    CURLcode rc =
        curl_easy_perform(
            curl
        );

    clock_gettime(
        CLOCK_MONOTONIC,
        &end
    );

    long http_status = 0;

    curl_easy_getinfo(
        curl,
        CURLINFO_RESPONSE_CODE,
        &http_status
    );

    curl_easy_cleanup(
        curl
    );

    bool intentionally_stopped =
        (
            rc ==
            CURLE_ABORTED_BY_CALLBACK
        ) &&
        (
            ctx.bytes >=
            ctx.limit
        );

    if (
        rc != CURLE_OK &&
        !intentionally_stopped
    ) {
        snprintf(
            error,
            error_size,
            "Network test failed: curl=%d HTTP=%ld",
            (int)rc,
            http_status
        );

        return false;
    }

    if (
        http_status != 200 &&
        http_status != 206
    ) {
        snprintf(
            error,
            error_size,
            "Network test returned HTTP %ld.",
            http_status
        );

        return false;
    }

    double seconds =
        elapsed_seconds(
            &start,
            &end
        );

    if (seconds <= 0.0) {
        snprintf(
            error,
            error_size,
            "Invalid timing result."
        );

        return false;
    }

    if (bytes_tested)
        *bytes_tested =
            ctx.bytes;

    if (mb_per_second) {
        *mb_per_second =
            (
                (double)ctx.bytes /
                1048576.0
            ) /
            seconds;
    }

    return true;
}


bool downloader_debug_sd(
    double *mb_per_second,
    char *error,
    size_t error_size
)
{
    if (mb_per_second)
        *mb_per_second = 0.0;

    DownloaderStats stats;

    downloader_get_stats(
        &stats
    );

    if (
        stats.active > 0 ||
        stats.queued > 0
    ) {
        snprintf(
            error,
            error_size,
            "Stop/wait for normal downloads before running diagnostics."
        );

        return false;
    }

    ensure_directories();

    static const char path[] =
        DOWNLOAD_DIR "/.speedtest.tmp";

    FILE *f =
        fopen(
            path,
            "wb"
        );

    if (!f) {
        snprintf(
            error,
            error_size,
            "Could not create SD speed-test file."
        );

        return false;
    }

    const size_t block_size =
        1024 * 1024;

    const int blocks =
        128;

    unsigned char *buffer =
        malloc(
            block_size
        );

    if (!buffer) {
        fclose(f);
        remove(path);

        snprintf(
            error,
            error_size,
            "Out of memory."
        );

        return false;
    }

    memset(
        buffer,
        0xA5,
        block_size
    );

    struct timespec start;
    struct timespec end;

    clock_gettime(
        CLOCK_MONOTONIC,
        &start
    );

    bool ok = true;

    for (
        int i = 0;
        i < blocks;
        i++
    ) {
        if (
            fwrite(
                buffer,
                1,
                block_size,
                f
            ) != block_size
        ) {
            ok = false;
            break;
        }
    }

    if (
        ok &&
        fflush(f) != 0
    ) {
        ok = false;
    }

    if (
        ok &&
        fsync(
            fileno(f)
        ) != 0
    ) {
        ok = false;
    }

    clock_gettime(
        CLOCK_MONOTONIC,
        &end
    );

    fclose(f);

    free(buffer);

    remove(path);

    if (!ok) {
        snprintf(
            error,
            error_size,
            "SD write test failed."
        );

        return false;
    }

    double seconds =
        elapsed_seconds(
            &start,
            &end
        );

    if (seconds <= 0.0) {
        snprintf(
            error,
            error_size,
            "Invalid timing result."
        );

        return false;
    }

    if (mb_per_second) {
        *mb_per_second =
            128.0 /
            seconds;
    }

    return true;
}


