typedef struct {
    CURL *easy;
    NetworkDiagContext progress;
    char range[64];
} SegmentTest;


bool downloader_debug_segmented(
    const char *source_url,
    double *mb_per_second,
    unsigned long long *bytes_tested,
    char *error,
    size_t error_size
)
{
    if (mb_per_second)
        *mb_per_second = 0.0;

    if (bytes_tested)
        *bytes_tested = 0;

    UnlockResult unlock;

    if (
        !unlock_link(
            source_url,
            &unlock
        )
    ) {
        snprintf(
            error,
            error_size,
            "Unlock failed: %s",
            unlock.error
        );

        return false;
    }

    CURLM *multi =
        curl_multi_init();

    if (!multi) {
        snprintf(
            error,
            error_size,
            "curl_multi_init failed."
        );

        return false;
    }

    enum {
        SEGMENTS = 4
    };

    const unsigned long long
        segment_size =
            2ULL *
            1024ULL *
            1024ULL;

    SegmentTest tests[
        SEGMENTS
    ];

    memset(
        tests,
        0,
        sizeof(tests)
    );

    bool setup_ok = true;

    for (
        int i = 0;
        i < SEGMENTS;
        i++
    ) {
        tests[i].easy =
            curl_easy_init();

        if (!tests[i].easy) {
            setup_ok = false;
            break;
        }

        unsigned long long start =
            (unsigned long long)i *
            segment_size;

        unsigned long long end =
            start +
            segment_size -
            1;

        snprintf(
            tests[i].range,
            sizeof(tests[i].range),
            "%llu-%llu",
            start,
            end
        );

        tests[i].progress.bytes = 0;
        tests[i].progress.limit =
            segment_size;

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_URL,
            unlock.direct_url
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_RANGE,
            tests[i].range
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_FOLLOWLOCATION,
            1L
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_MAXREDIRS,
            10L
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_WRITEFUNCTION,
            network_diag_write
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_WRITEDATA,
            &tests[i].progress
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_XFERINFOFUNCTION,
            network_diag_progress
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_XFERINFODATA,
            &tests[i].progress
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_NOPROGRESS,
            0L
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_CONNECTTIMEOUT,
            30L
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_TIMEOUT,
            60L
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_NOSIGNAL,
            1L
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_SSL_VERIFYPEER,
            1L
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_SSL_VERIFYHOST,
            2L
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_HTTP_VERSION,
            CURL_HTTP_VERSION_1_1
        );

        /*
         * Force these to be separate HTTP connections.
         */
        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_FRESH_CONNECT,
            1L
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_USERAGENT,
            g_user_agent[0]
                ? g_user_agent
                : "SwitchDebridDownloader"
        );

        CURLMcode mrc =
            curl_multi_add_handle(
                multi,
                tests[i].easy
            );

        if (
            mrc != CURLM_OK
        ) {
            setup_ok = false;
            break;
        }
    }

    if (!setup_ok) {
        for (
            int i = 0;
            i < SEGMENTS;
            i++
        ) {
            if (
                tests[i].easy
            ) {
                curl_multi_remove_handle(
                    multi,
                    tests[i].easy
                );

                curl_easy_cleanup(
                    tests[i].easy
                );
            }
        }

        curl_multi_cleanup(
            multi
        );

        snprintf(
            error,
            error_size,
            "Could not prepare segmented test."
        );

        return false;
    }

    struct timespec start_time;
    struct timespec end_time;

    clock_gettime(
        CLOCK_MONOTONIC,
        &start_time
    );

    int running = 0;

    CURLMcode mrc =
        curl_multi_perform(
            multi,
            &running
        );

    while (
        mrc == CURLM_OK &&
        running > 0
    ) {
        int numfds = 0;

        mrc =
            curl_multi_wait(
                multi,
                NULL,
                0,
                1000,
                &numfds
            );

        if (
            mrc != CURLM_OK
        ) {
            break;
        }

        mrc =
            curl_multi_perform(
                multi,
                &running
            );
    }

    clock_gettime(
        CLOCK_MONOTONIC,
        &end_time
    );

    bool success =
        mrc == CURLM_OK;

    unsigned long long
        total_bytes = 0;

    for (
        int i = 0;
        i < SEGMENTS;
        i++
    ) {
        long http_status = 0;

        curl_easy_getinfo(
            tests[i].easy,
            CURLINFO_RESPONSE_CODE,
            &http_status
        );

        total_bytes +=
            tests[i].progress.bytes;

        /*
         * A segmented transfer is only valid when
         * the server actually honors Range.
         */
        if (
            http_status != 206
        ) {
            success = false;

            snprintf(
                error,
                error_size,
                "Server did not honor byte ranges "
                "(segment %d returned HTTP %ld).",
                i + 1,
                http_status
            );
        }
    }

    for (
        int i = 0;
        i < SEGMENTS;
        i++
    ) {
        curl_multi_remove_handle(
            multi,
            tests[i].easy
        );

        curl_easy_cleanup(
            tests[i].easy
        );
    }

    curl_multi_cleanup(
        multi
    );

    if (!success) {
        if (!error[0]) {
            snprintf(
                error,
                error_size,
                "Segmented curl test failed."
            );
        }

        return false;
    }

    double seconds =
        elapsed_seconds(
            &start_time,
            &end_time
        );

    if (seconds <= 0.0) {
        snprintf(
            error,
            error_size,
            "Invalid timing result."
        );

        return false;
    }

    if (bytes_tested)
        *bytes_tested =
            total_bytes;

    if (mb_per_second) {
        *mb_per_second =
            (
                (double)total_bytes /
                1048576.0
            ) /
            seconds;
    }

    return true;
}



static void direct_url_host(
    const char *url,
    char *host,
    size_t host_size
)
{
    if (
        !url ||
        !host ||
        host_size == 0
    ) {
        return;
    }

    host[0] = '\0';

    const char *start =
        strstr(
            url,
            "://"
        );

    if (start)
        start += 3;
    else
        start = url;

    const char *end =
        start;

    while (
        *end &&
        *end != '/' &&
        *end != '?' &&
        *end != '#' &&
        *end != ':'
    ) {
        end++;
    }

    size_t len =
        (size_t)(
            end -
            start
        );

    if (
        len >=
        host_size
    ) {
        len =
            host_size - 1;
    }

    memcpy(
        host,
        start,
        len
    );

    host[len] = '\0';
}


bool downloader_unlock_direct_url(
    const char *source_url,
    char *direct_url,
    size_t direct_url_size,
    char *error,
    size_t error_size
)
{
    if (
        !direct_url ||
        direct_url_size == 0
    ) {
        snprintf(
            error,
            error_size,
            "Invalid output buffer."
        );

        return false;
    }

    direct_url[0] = '\0';

    UnlockResult unlock;

    if (
        !unlock_link(
            source_url,
            &unlock
        )
    ) {
        snprintf(
            error,
            error_size,
            "Unlock failed: %s",
            unlock.error[0]
                ? unlock.error
                : "unknown error"
        );

        return false;
    }

    /*
     * Do not allow a URL to inject extra HTTP headers.
     */
    if (
        strchr(
            unlock.direct_url,
            '\r'
        ) ||
        strchr(
            unlock.direct_url,
            '\n'
        )
    ) {
        snprintf(
            error,
            error_size,
            "Invalid direct URL."
        );

        return false;
    }

    if (
        strlen(
            unlock.direct_url
        ) >=
        direct_url_size
    ) {
        snprintf(
            error,
            error_size,
            "Direct URL is too long."
        );

        return false;
    }

    snprintf(
        direct_url,
        direct_url_size,
        "%s",
        unlock.direct_url
    );

    return true;
}


