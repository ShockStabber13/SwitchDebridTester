bool downloader_init(
    const char *token,
    const char *user_agent,
    int max_concurrent
)
{
    memset(
        &g_queue,
        0,
        sizeof(g_queue)
    );

    memset(
        g_worker_progress,
        0,
        sizeof(g_worker_progress)
    );

    g_completed = 0;
    g_failed = 0;

    mutexInit(
        &g_mutex
    );

    snprintf(
        g_token,
        sizeof(g_token),
        "%s",
        token ? token : ""
    );

    snprintf(
        g_user_agent,
        sizeof(g_user_agent),
        "%s",
        user_agent
            ? user_agent
            : "SwitchDebridDownloader"
    );

    if (
        max_concurrent < 1
    ) {
        max_concurrent = 1;
    }

    if (
        max_concurrent >
        MAX_WORKERS
    ) {
        max_concurrent =
            MAX_WORKERS;
    }

    ensure_directories();

    g_running = true;

    for (
        int i = 0;
        i < max_concurrent;
        i++
    ) {
        Result rc =
            threadCreate(
                &g_threads[i],
                worker_thread,
                (void *)(intptr_t)i,
                NULL,
                0x40000,
                0x3B,
                -2
            );

        if (
            R_FAILED(rc)
        ) {
            break;
        }

        rc =
            threadStart(
                &g_threads[i]
            );

        if (
            R_FAILED(rc)
        ) {
            threadClose(
                &g_threads[i]
            );

            break;
        }

        g_thread_count++;
    }

    return
        g_thread_count > 0;
}


void downloader_shutdown(void)
{
    if (!g_running)
        return;

    g_running = false;

    for (
        int i = 0;
        i < g_thread_count;
        i++
    ) {
        threadWaitForExit(
            &g_threads[i]
        );

        threadClose(
            &g_threads[i]
        );
    }

    g_thread_count = 0;

    mutexLock(
        &g_mutex
    );

    while (
        g_queue.count > 0
    ) {
        char *job =
            g_queue.items[
                g_queue.head
            ];

        g_queue.head =
            (
                g_queue.head +
                1
            ) %
            MAX_QUEUE;

        g_queue.count--;

        free(job);
    }

    mutexUnlock(
        &g_mutex
    );
}


void downloader_get_stats(
    DownloaderStats *stats
)
{
    if (!stats)
        return;

    memset(
        stats,
        0,
        sizeof(*stats)
    );

    mutexLock(
        &g_mutex
    );

    stats->queued =
        g_queue.count;

    stats->completed =
        g_completed;

    stats->failed =
        g_failed;

    for (
        int i = 0;
        i < g_thread_count;
        i++
    ) {
        if (
            g_worker_progress[i].active
        ) {
            stats->active++;

            stats->current_downloaded +=
                g_worker_progress[i].downloaded;

            stats->current_total +=
                g_worker_progress[i].total;

            stats->current_bytes_per_second +=
                g_worker_progress[i].bytes_per_second;
        }
    }

    mutexUnlock(
        &g_mutex
    );
}
