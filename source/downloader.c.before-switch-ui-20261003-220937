static bool segmented_large_test(
    const char *source_url,
    int segment_count,
    double *mb_per_second,
    unsigned long long *bytes_tested,
    char *error,
    size_t error_size
)
{
    if (mb_per_second)
        *mb_per_second = 0.0;

    if (bytes_tested)
        *bytes_tested = 0;

    if (
        segment_count != 8 &&
        segment_count != 16
    ) {
        snprintf(
            error,
            error_size,
            "Unsupported segment count."
        );

        return false;
    }

    DownloaderStats stats;

    downloader_get_stats(
        &stats
    );

    if (
        stats.active > 0 ||
        stats.queued > 0
    ) {
        snprintf(
            error,
            error_size,
            "Wait for normal downloads to finish first."
        );

        return false;
    }

    UnlockResult unlock;

    if (
        !unlock_link(
            source_url,
            &unlock
        )
    ) {
        snprintf(
            error,
            error_size,
            "Unlock failed: %s",
            unlock.error[0]
                ? unlock.error
                : "unknown error"
        );

        return false;
    }

    /*
     * Total benchmark size = 128 MiB.
     *
     * 8 connections  = 16 MiB each
     * 16 connections =  8 MiB each
     */
    const unsigned long long total_size =
        32ULL *
        1024ULL *
        1024ULL;

    const unsigned long long segment_size =
        total_size /
        (unsigned long long)segment_count;

    SegmentTest *tests =
        calloc(
            (size_t)segment_count,
            sizeof(*tests)
        );

    if (!tests) {
        snprintf(
            error,
            error_size,
            "Out of memory allocating segment table."
        );

        return false;
    }

    CURLM *multi =
        curl_multi_init();

    if (!multi) {
        free(tests);

        snprintf(
            error,
            error_size,
            "curl_multi_init failed."
        );

        return false;
    }

    CURLcode results[16];

    for (
        int i = 0;
        i < 16;
        i++
    ) {
        results[i] =
            CURLE_OK;
    }

    bool setup_ok = true;

    for (
        int i = 0;
        i < segment_count;
        i++
    ) {
        tests[i].easy =
            curl_easy_init();

        if (!tests[i].easy) {
            setup_ok = false;
            break;
        }

        unsigned long long range_start =
            (unsigned long long)i *
            segment_size;

        unsigned long long range_end =
            range_start +
            segment_size -
            1;

        snprintf(
            tests[i].range,
            sizeof(tests[i].range),
            "%llu-%llu",
            range_start,
            range_end
        );

        tests[i].progress.bytes = 0;
        tests[i].progress.limit =
            segment_size;

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_URL,
            unlock.direct_url
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_RANGE,
            tests[i].range
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_FOLLOWLOCATION,
            1L
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_MAXREDIRS,
            10L
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_WRITEFUNCTION,
            network_diag_write
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_WRITEDATA,
            &tests[i].progress
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_CONNECTTIMEOUT,
            30L
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_TIMEOUT,
            180L
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_NOSIGNAL,
            1L
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_SSL_VERIFYPEER,
            1L
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_SSL_VERIFYHOST,
            2L
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_HTTP_VERSION,
            CURL_HTTP_VERSION_1_1
        );

        /*
         * We specifically want independent TCP connections.
         */
        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_FRESH_CONNECT,
            1L
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_FORBID_REUSE,
            1L
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_USERAGENT,
            g_user_agent[0]
                ? g_user_agent
                : "SwitchDebridDownloader"
        );

        CURLMcode mrc =
            curl_multi_add_handle(
                multi,
                tests[i].easy
            );

        if (mrc != CURLM_OK) {
            setup_ok = false;
            break;
        }
    }

    if (!setup_ok) {
        for (
            int i = 0;
            i < segment_count;
            i++
        ) {
            if (tests[i].easy) {
                curl_multi_remove_handle(
                    multi,
                    tests[i].easy
                );

                curl_easy_cleanup(
                    tests[i].easy
                );
            }
        }

        curl_multi_cleanup(
            multi
        );

        free(tests);

        snprintf(
            error,
            error_size,
            "Could not prepare segmented test."
        );

        return false;
    }

    struct timespec start_time;
    struct timespec end_time;

    clock_gettime(
        CLOCK_MONOTONIC,
        &start_time
    );

    int running = 0;

    CURLMcode mrc =
        curl_multi_perform(
            multi,
            &running
        );

    while (
        mrc == CURLM_OK &&
        running > 0
    ) {
        int numfds = 0;

        mrc =
            curl_multi_wait(
                multi,
                NULL,
                0,
                1000,
                &numfds
            );

        if (mrc != CURLM_OK)
            break;

        mrc =
            curl_multi_perform(
                multi,
                &running
            );
    }

    clock_gettime(
        CLOCK_MONOTONIC,
        &end_time
    );

    /*
     * Collect the actual CURLcode for every easy handle.
     * HTTP response code alone is 0 when the request never
     * reached the point of receiving an HTTP response.
     */
    int messages_left = 0;
    CURLMsg *message = NULL;

    while (
        (
            message =
                curl_multi_info_read(
                    multi,
                    &messages_left
                )
        ) != NULL
    ) {
        if (
            message->msg !=
            CURLMSG_DONE
        ) {
            continue;
        }

        for (
            int i = 0;
            i < segment_count;
            i++
        ) {
            if (
                tests[i].easy ==
                message->easy_handle
            ) {
                results[i] =
                    message->data.result;

                break;
            }
        }
    }

    bool success =
        mrc == CURLM_OK;

    unsigned long long total_bytes = 0;

    for (
        int i = 0;
        i < segment_count;
        i++
    ) {
        long http_status = 0;

        curl_easy_getinfo(
            tests[i].easy,
            CURLINFO_RESPONSE_CODE,
            &http_status
        );

        total_bytes +=
            tests[i].progress.bytes;

        /*
         * The test only means anything when the host
         * actually honours each byte range.
         */
        if (
            results[i] != CURLE_OK ||
            http_status != 206
        ) {
            success = false;

            long os_errno = 0;

            curl_easy_getinfo(
                tests[i].easy,
                CURLINFO_OS_ERRNO,
                &os_errno
            );

            snprintf(
                error,
                error_size,

                "Segment %d failed: "
                "curl=%d (%s), "
                "HTTP=%ld, "
                "OS errno=%ld",

                i + 1,
                (int)results[i],
                curl_easy_strerror(
                    results[i]
                ),
                http_status,
                os_errno
            );

            /*
             * Keep the first failure; it is generally the
             * most useful one.
             */
            break;
        }
    }

    for (
        int i = 0;
        i < segment_count;
        i++
    ) {
        if (tests[i].easy) {
            curl_multi_remove_handle(
                multi,
                tests[i].easy
            );

            curl_easy_cleanup(
                tests[i].easy
            );
        }
    }

    curl_multi_cleanup(
        multi
    );

    free(tests);

    if (!success) {
        if (!error[0]) {
            snprintf(
                error,
                error_size,
                "Segmented curl test failed."
            );
        }

        return false;
    }

    double seconds =
        elapsed_seconds(
            &start_time,
            &end_time
        );

    if (seconds <= 0.0) {
        snprintf(
            error,
            error_size,
            "Invalid timing result."
        );

        return false;
    }

    if (bytes_tested)
        *bytes_tested =
            total_bytes;

    if (mb_per_second) {
        *mb_per_second =
            (
                (double)total_bytes /
                1048576.0
            ) /
            seconds;
    }

    return true;
}


