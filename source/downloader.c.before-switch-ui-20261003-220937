        &http_status
    );

    curl_easy_cleanup(
        curl
    );

    bool intentionally_stopped =
        (
            rc ==
            CURLE_ABORTED_BY_CALLBACK
        ) &&
        (
            ctx.bytes >=
            ctx.limit
        );

    if (
        rc != CURLE_OK &&
        !intentionally_stopped
    ) {
        snprintf(
            error,
            error_size,
            "curl=%d HTTP=%ld",
            (int)rc,
            http_status
        );

        return false;
    }

    if (http_status != 200) {
        snprintf(
            error,
            error_size,
            "Expected HTTP 200, got %ld",
            http_status
        );

        return false;
    }

    double seconds =
        elapsed_seconds(
            &start,
            &end
        );

    if (seconds <= 0.0) {
        snprintf(
            error,
            error_size,
            "Invalid timing result."
        );

        return false;
    }

    if (bytes_tested)
        *bytes_tested =
            ctx.bytes;

    if (mb_per_second) {
        *mb_per_second =
            (
                (double)ctx.bytes /
                1048576.0
            ) /
            seconds;
    }

    return true;
}


