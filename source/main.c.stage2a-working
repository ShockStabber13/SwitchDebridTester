    send_all(
        fd,
        response,
        sizeof(response) - 1
    );
}


/* --------------------------------------------------------- */
/* HTTP request reader                                       */
/* --------------------------------------------------------- */

static ssize_t read_request(
    int fd
)
{
    size_t used = 0;

    while (
        used + 1 <
        sizeof(g_request)
    ) {
        ssize_t n =
            recv(
                fd,
                g_request + used,
                sizeof(g_request)
                    - used
                    - 1,
                0
            );

        if (n <= 0)
            break;

        used +=
            (size_t)n;

        g_request[used] =
            '\0';

        char *headers_end =
            strstr(
                g_request,
                "\r\n\r\n"
            );

        if (!headers_end)
            continue;

        if (
            strncmp(
                g_request,
                "GET ",
                4
            ) == 0
        ) {
            break;
        }

        const char *cl =
            strstr(
                g_request,
                "Content-Length:"
            );

        if (!cl) {
            cl =
                strstr(
                    g_request,
                    "content-length:"
                );
        }

        if (cl) {
            size_t content_length =
                strtoul(
                    cl + 15,
                    NULL,
                    10
                );

            size_t header_length =
                (size_t)(
                    headers_end +
                    4 -
                    g_request
                );

            if (
                used >=
                header_length +
                content_length
            ) {
                break;
            }
        }
        else {
            break;
        }
    }

    g_request[used] = '\0';

    return (ssize_t)used;
}


/* --------------------------------------------------------- */
/* HTTP routes                                               */
/* --------------------------------------------------------- */

static void handle_client(
    int fd
)
{
    if (
        read_request(fd) <= 0
    ) {
        return;
    }

    if (
        strncmp(
            g_request,
            "GET / ",
            6
        ) == 0
    ) {
        send_page(
            fd,
            "Ready."
        );

        return;
    }

    if (
        strncmp(
            g_request,
            "GET /reload-config ",
            19
        ) == 0
    ) {
        load_config();

        send_redirect(fd);

        return;
    }

    if (
        strncmp(
            g_request,
            "GET /torbox-test ",
            17
        ) == 0
    ) {
        if (!g_torbox_token[0]) {
            send_page(
                fd,
                "TorBox token is not configured."
            );

            return;
        }

        long status = 0;
        CURLcode curl_result;

        bool ok =
            torbox_auth_test(
                &status,
                &curl_result
            );

        char message[256];

        if (ok) {
            snprintf(
                message,
                sizeof(message),
                "TorBox authentication OK. "
                "HTTP %ld.",
                status
            );
        }
        else {
            snprintf(
                message,
                sizeof(message),
                "TorBox authentication failed. "
                "HTTP %ld, curl %d.",
                status,
                (int)curl_result
            );
        }

        send_page(
            fd,
            message
        );

        return;
    }

    if (
        strncmp(
            g_request,
            "POST /submit ",
            13
        ) == 0
    ) {
        char *body =
            strstr(
                g_request,
                "\r\n\r\n"
            );

        if (!body) {
            send_page(
                fd,
                "Invalid request."
            );

            return;
        }

        body += 4;

        memset(
            g_provider,
            0,
            sizeof(g_provider)
        );

        memset(
            g_links,
            0,
            sizeof(g_links)
        );

        form_value(
            body,
            "provider",
            g_provider,
            sizeof(g_provider)
        );

        form_value(
            body,
            "links",
            g_links,
            sizeof(g_links)
        );

        sanitize_field(
            g_provider
        );

        if (
            strcmp(
                g_provider,
                "torbox"
            ) != 0 &&
            strcmp(
                g_provider,
                "alldebrid"
            ) != 0
        ) {
            send_page(
                fd,
                "Invalid provider."
            );

            return;
        }

        if (!g_links[0]) {
            send_page(
                fd,
                "Paste at least one link."
            );

            return;
        }

        g_last_queued =
            queue_multiple_links(
                g_provider,
                g_links
            );

        printf(
            "\nQueued %u link(s) "
            "for %s.\n",
            g_last_queued,
            g_provider
        );

        consoleUpdate(NULL);

        send_redirect(fd);

        return;
    }

    static const char not_found[] =
        "HTTP/1.1 404 Not Found\r\n"
        "Content-Length: 0\r\n"
        "Connection: close\r\n"
        "\r\n";

    send_all(
        fd,
        not_found,
        sizeof(not_found) - 1
    );
}


/* --------------------------------------------------------- */
/* Main                                                      */
/* --------------------------------------------------------- */

int main(
    int argc,
    char **argv
)
{
    (void)argc;
    (void)argv;

    consoleInit(NULL);

    padConfigureInput(
        1,
        HidNpadStyleSet_NpadStandard
    );

    PadState pad;
    padInitializeDefault(&pad);

    printf(
        "Switch Debrid Downloader\n"
        "Stage 2A - Multi-Link Queue\n\n"
    );

    load_config();

    Result rc =
        socketInitializeDefault();

    if (R_FAILED(rc)) {
        printf(
            "Network init failed: "
            "0x%08X\n",
            rc
        );

        consoleUpdate(NULL);

        while (appletMainLoop()) {
            padUpdate(&pad);

            if (
                padGetButtonsDown(&pad) &
                HidNpadButton_Plus
            ) {
                break;
            }
        }

        consoleExit(NULL);

        return 0;
    }

    CURLcode curl_init =
        curl_global_init(
            CURL_GLOBAL_DEFAULT
        );

    if (
        curl_init !=
        CURLE_OK
    ) {
        printf(
            "curl init failed: %d\n",
            (int)curl_init
        );

        consoleUpdate(NULL);

        while (appletMainLoop()) {
            padUpdate(&pad);

            if (
                padGetButtonsDown(&pad) &
                HidNpadButton_Plus
            ) {
                break;
            }
        }

        socketExit();
        consoleExit(NULL);

        return 0;
    }

    int server =
        socket(
            AF_INET,
            SOCK_STREAM,
            0
        );

    if (server < 0) {
        printf(
            "socket failed: %d\n",
            errno
        );

        curl_global_cleanup();
        socketExit();
        consoleExit(NULL);

        return 0;
    }

    int yes = 1;

    setsockopt(
        server,
        SOL_SOCKET,
        SO_REUSEADDR,
        &yes,
        sizeof(yes)
    );

    struct sockaddr_in addr;

    memset(
        &addr,
        0,
        sizeof(addr)
    );

    addr.sin_family =
        AF_INET;

    addr.sin_port =
        htons(PORT);

    addr.sin_addr.s_addr =
        INADDR_ANY;

    if (
        bind(
            server,
            (struct sockaddr *)&addr,
            sizeof(addr)
        ) != 0 ||
        listen(
            server,
            8
        ) != 0
    ) {
        printf(
            "Server startup failed: %d\n",
            errno
        );

        consoleUpdate(NULL);

        while (appletMainLoop()) {
            padUpdate(&pad);

            if (
                padGetButtonsDown(&pad) &
                HidNpadButton_Plus
            ) {
                break;
            }
        }

        close(server);
        curl_global_cleanup();
        socketExit();
        consoleExit(NULL);

        return 0;
    }

    printf(
        "READY\n\n"
        "Phone:\n"
        "http://SWITCH-IP:%d\n\n"
        "TorBox token: %s\n"
        "AllDebrid token: %s\n"
        "Max concurrent: %d\n\n"
        "Press + to exit.\n",

        PORT,

        g_torbox_token[0]
            ? "loaded"
            : "not configured",

        g_alldebrid_token[0]
            ? "loaded"
            : "not configured",

        g_max_concurrent
    );

    consoleUpdate(NULL);

    while (
        appletMainLoop()
    ) {
        padUpdate(&pad);

        if (
            padGetButtonsDown(&pad) &
            HidNpadButton_Plus
        ) {
            break;
        }

        fd_set fds;

        FD_ZERO(&fds);
        FD_SET(server, &fds);

        struct timeval tv = {
            .tv_sec = 0,
            .tv_usec = 100000
        };

        int ready =
            select(
                server + 1,
                &fds,
                NULL,
                NULL,
                &tv
            );

        if (
            ready > 0 &&
            FD_ISSET(
                server,
                &fds
            )
        ) {
            int client =
                accept(
                    server,
                    NULL,
                    NULL
                );

            if (client >= 0) {
                struct timeval timeout;

                timeout.tv_sec = 5;
                timeout.tv_usec = 0;

                setsockopt(
                    client,
                    SOL_SOCKET,
                    SO_RCVTIMEO,
                    &timeout,
                    sizeof(timeout)
                );

                setsockopt(
                    client,
                    SOL_SOCKET,
                    SO_SNDTIMEO,
                    &timeout,
                    sizeof(timeout)
                );

                handle_client(
                    client
                );

                close(client);
            }
        }
    }

    close(server);

    curl_global_cleanup();

    socketExit();

    consoleExit(NULL);

    return 0;
}
