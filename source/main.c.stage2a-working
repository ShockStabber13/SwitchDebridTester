static void ensure_config_dir(void)
{
    mkdir(
        "sdmc:/config",
        0777
    );

    mkdir(
        CONFIG_DIR,
        0777
    );
}


static bool create_default_config(void)
{
    ensure_config_dir();

    FILE *f =
        fopen(
            CONFIG_FILE,
            "wb"
        );

    if (!f)
        return false;

    static const char config[] =
        "[torbox]\n"
        "token=\n"
        "\n"
        "[alldebrid]\n"
        "name=SwitchDebridDownloader\n"
        "token=\n"
        "\n"
        "[downloads]\n"
        "max_concurrent=2\n";

    bool ok =
        fwrite(
            config,
            1,
            sizeof(config) - 1,
            f
        ) ==
        sizeof(config) - 1;

    fclose(f);

    return ok;
}


static bool load_config(void)
{
    g_torbox_token[0] = '\0';
    g_alldebrid_token[0] = '\0';
    snprintf(
        g_alldebrid_name,
        sizeof(g_alldebrid_name),
        "SwitchDebridDownloader"
    );
    g_max_concurrent = 2;

    ensure_config_dir();

    FILE *f =
        fopen(
            CONFIG_FILE,
            "rb"
        );

    if (!f) {
        create_default_config();
        return false;
    }

    char line[2048];
    char section[64] = {0};

    while (
        fgets(
            line,
            sizeof(line),
            f
        )
    ) {
        char *p = trim(line);

        if (
            !p[0] ||
            p[0] == '#' ||
            p[0] == ';'
        ) {
            continue;
        }

        if (p[0] == '[') {
            char *end =
                strchr(
                    p,
                    ']'
                );

            if (!end)
                continue;

            *end = '\0';

            snprintf(
                section,
                sizeof(section),
                "%s",
                p + 1
            );

            continue;
        }

        char *equals =
            strchr(
                p,
                '='
            );

        if (!equals)
            continue;

        *equals = '\0';

        char *key =
            trim(p);

        char *value =
            trim(equals + 1);

        if (
            strcasecmp(
                section,
                "torbox"
            ) == 0 &&
            strcasecmp(
                key,
                "token"
            ) == 0
        ) {
            snprintf(
                g_torbox_token,
                sizeof(g_torbox_token),
                "%s",
                value
            );
        }
        else if (
            strcasecmp(section, "alldebrid") == 0 &&
            strcasecmp(key, "name") == 0
        ) {
            snprintf(
                g_alldebrid_name,
                sizeof(g_alldebrid_name),
                "%s",
                value
            );
        }
        else if (
            strcasecmp(
                section,
                "alldebrid"
            ) == 0 &&
            strcasecmp(
                key,
                "token"
            ) == 0
        ) {
            snprintf(
                g_alldebrid_token,
                sizeof(g_alldebrid_token),
                "%s",
                value
            );
        }
        else if (
            strcasecmp(
                section,
                "downloads"
            ) == 0 &&
            strcasecmp(
                key,
                "max_concurrent"
            ) == 0
        ) {
            int n =
                atoi(value);

            if (n < 1)
                n = 1;

            if (n > 8)
                n = 8;

            g_max_concurrent = n;
        }
    }

    fclose(f);

    return true;
}


/* --------------------------------------------------------- */
/* URL/form decoding                                         */
/* --------------------------------------------------------- */

static void url_decode(
    char *dst,
    size_t dst_size,
    const char *src,
    size_t src_len
)
{
    size_t out = 0;

    for (
        size_t i = 0;
        i < src_len &&
        out + 1 < dst_size;
        i++
    ) {
        if (
            src[i] == '%' &&
            i + 2 < src_len
        ) {
            int hi =
                hex_value(
                    src[i + 1]
                );

            int lo =
                hex_value(
                    src[i + 2]
                );

            if (
                hi >= 0 &&
                lo >= 0
            ) {
                dst[out++] =
                    (char)(
                        (hi << 4) |
                        lo
                    );

                i += 2;
                continue;
            }
        }

        if (src[i] == '+')
            dst[out++] = ' ';
        else
            dst[out++] = src[i];
    }

    dst[out] = '\0';
}


static bool form_value(
    const char *body,
    const char *name,
    char *output,
    size_t output_size
)
{
    char key[64];

    snprintf(
        key,
        sizeof(key),
        "%s=",
        name
    );

    size_t key_len =
        strlen(key);

    const char *p =
        body;

    while (*p) {
        if (
            (
                p == body ||
                p[-1] == '&'
            ) &&
            strncmp(
                p,
                key,
                key_len
            ) == 0
        ) {
            p += key_len;

            const char *end =
                strchr(
                    p,
                    '&'
                );

            size_t len =
                end
                    ? (size_t)(end - p)
                    : strlen(p);

            url_decode(
                output,
                output_size,
                p,
                len
            );

            return true;
        }

        p =
            strchr(
                p,
                '&'
            );

        if (!p)
            break;

        p++;
    }

    output[0] = '\0';

    return false;
}


/* --------------------------------------------------------- */
/* Local pending queue                                       */
/* --------------------------------------------------------- */

static bool append_pending(
    const char *provider,
    const char *link
)
{
    ensure_config_dir();

    FILE *f =
        fopen(
            PENDING_FILE,
            "a"
        );

    if (!f)
        return false;

    fprintf(
        f,
        "%s\t%s\n",
        provider,
        link
    );

    fclose(f);

    return true;
}


static unsigned queue_multiple_links(
    const char *provider,
    char *links
)
{
    unsigned count = 0;

    char *p = links;

    while (*p) {
        char *start = p;

        while (
            *p &&
            *p != '\r' &&
            *p != '\n'
        ) {
            p++;
        }

        char saved = *p;
        *p = '\0';

        char *line =
            trim(start);

        sanitize_field(line);

        if (line[0]) {
            if (
                append_pending(
                    provider,
                    line
                )
            ) {
                count++;
            }
        }

        if (!saved)
            break;

        p++;

        while (
            *p == '\r' ||
            *p == '\n'
        ) {
            p++;
        }
    }

    return count;
}


/* --------------------------------------------------------- */
/* TorBox config/auth test                                   */
/* --------------------------------------------------------- */

static size_t curl_discard(
    char *ptr,
    size_t size,
    size_t nmemb,
    void *userdata
)
{
    (void)ptr;
    (void)userdata;

    return size * nmemb;
}


static bool torbox_auth_test(
    long *http_status,
    CURLcode *curl_result
)
{
    *http_status = 0;
    *curl_result =
        CURLE_FAILED_INIT;

    if (!g_torbox_token[0])
        return false;

    CURL *curl =
        curl_easy_init();

    if (!curl)
        return false;

    char authorization[1200];

    snprintf(
        authorization,
        sizeof(authorization),
        "Authorization: Bearer %s",
        g_torbox_token
    );

    struct curl_slist *headers =
        NULL;

    headers =
        curl_slist_append(
            headers,
            authorization
        );

    curl_easy_setopt(
        curl,
        CURLOPT_URL,
        "https://api.torbox.app/v1/api/webdl/mylist?limit=1"
    );

    curl_easy_setopt(
        curl,
        CURLOPT_HTTPHEADER,
        headers
    );

    curl_easy_setopt(
        curl,
        CURLOPT_WRITEFUNCTION,
        curl_discard
    );

    curl_easy_setopt(
        curl,
        CURLOPT_CONNECTTIMEOUT,
        15L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_TIMEOUT,
        30L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_NOSIGNAL,
        1L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_HTTP_VERSION,
        CURL_HTTP_VERSION_1_1
    );

    curl_easy_setopt(
        curl,
        CURLOPT_SSL_VERIFYPEER,
        1L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_SSL_VERIFYHOST,
        2L
    );

    *curl_result =
        curl_easy_perform(
            curl
        );

    curl_easy_getinfo(
        curl,
        CURLINFO_RESPONSE_CODE,
        http_status
    );

    curl_easy_cleanup(curl);

    if (headers)
        curl_slist_free_all(
            headers
        );

    return
        *curl_result ==
            CURLE_OK &&
        *http_status ==
            200;
}


