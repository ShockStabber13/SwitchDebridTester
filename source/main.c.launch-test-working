#include <switch.h>
#include <stdio.h>

int main(int argc, char **argv)
{
    (void)argc;
    (void)argv;

    consoleInit(NULL);

    padConfigureInput(
        1,
        HidNpadStyleSet_NpadStandard
    );

    PadState pad;
    padInitializeDefault(&pad);

    printf(
        "Switch Debrid Downloader\n\n"
        "NRO launch test SUCCESS.\n\n"
        "Press + to exit.\n"
    );

    while (appletMainLoop()) {
        padUpdate(&pad);

        if (
            padGetButtonsDown(&pad) &
            HidNpadButton_Plus
        ) {
            break;
        }

        consoleUpdate(NULL);
    }

    consoleExit(NULL);
    return 0;
}
