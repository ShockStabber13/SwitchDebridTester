static bool create_default_config(void)
{
    ensure_config_dir();

    FILE *f =
        fopen(
            CONFIG_FILE,
            "wb"
        );

    if (!f)
        return false;

    static const char config[] =
        "[downloads]\n"
        "max_concurrent=2\n";

    bool ok =
        fwrite(
            config,
            1,
            sizeof(config) - 1,
            f
        ) ==
        sizeof(config) - 1;

    fclose(f);

    return ok;
}


static bool load_config(void)
{
    g_alldebrid_token[0] = '\0';

    snprintf(
        g_alldebrid_name,
        sizeof(g_alldebrid_name),
        "SwitchDebridDownloader"
    );

    g_max_concurrent = 2;

    ensure_config_dir();

    FILE *f =
        fopen(
            CONFIG_FILE,
            "rb"
        );

    if (!f) {
        create_default_config();
        return false;
    }

    char line[2048];
    char section[64] = {0};

    while (
        fgets(
            line,
            sizeof(line),
            f
        )
    ) {
        char *p =
            trim(line);

        if (
            !p[0] ||
            p[0] == '#' ||
            p[0] == ';'
        ) {
            continue;
        }

        if (p[0] == '[') {
            char *end =
                strchr(
                    p,
                    ']'
                );

            if (!end)
                continue;

            *end = '\0';

            snprintf(
                section,
                sizeof(section),
                "%s",
                p + 1
            );

            continue;
        }

        char *equals =
            strchr(
                p,
                '='
            );

        if (!equals)
            continue;

        *equals = '\0';

        char *key =
            trim(p);

        char *value =
            trim(
                equals + 1
            );

        if (
            strcasecmp(
                section,
                "alldebrid"
            ) == 0 &&
            strcasecmp(
                key,
                "name"
            ) == 0
        ) {
            snprintf(
                g_alldebrid_name,
                sizeof(g_alldebrid_name),
                "%s",
                value
            );
        }
        else if (
            strcasecmp(
                section,
                "alldebrid"
            ) == 0 &&
            strcasecmp(
                key,
                "token"
            ) == 0
        ) {
            snprintf(
                g_alldebrid_token,
                sizeof(g_alldebrid_token),
                "%s",
                value
            );
        }
        else if (
            strcasecmp(
                section,
                "downloads"
            ) == 0 &&
            strcasecmp(
                key,
                "max_concurrent"
            ) == 0
        ) {
            int n =
                atoi(value);

            if (n < 1)
                n = 1;

            if (n > 8)
                n = 8;

            g_max_concurrent = n;
        }
    }

    fclose(f);

    return true;
}


/* ========================================================= */
/* Form decoding                                             */
/* ========================================================= */

static void url_decode(
    char *dst,
    size_t dst_size,
    const char *src,
    size_t src_len
)
{
    size_t out = 0;

    for (
        size_t i = 0;
        i < src_len &&
        out + 1 < dst_size;
        i++
    ) {
        if (
            src[i] == '%' &&
            i + 2 < src_len
        ) {
            int hi =
                hex_value(
                    src[i + 1]
                );

            int lo =
                hex_value(
                    src[i + 2]
                );

            if (
                hi >= 0 &&
                lo >= 0
            ) {
                dst[out++] =
                    (char)(
                        (hi << 4) |
                        lo
                    );

                i += 2;
                continue;
            }
        }

        if (src[i] == '+')
            dst[out++] = ' ';
        else
            dst[out++] = src[i];
    }

    dst[out] = '\0';
}


static bool form_value(
    const char *body,
    const char *name,
    char *output,
    size_t output_size
)
{
    char key[64];

    snprintf(
        key,
        sizeof(key),
        "%s=",
        name
    );

    size_t key_len =
        strlen(key);

    const char *p =
        body;

    while (*p) {
        if (
            (
                p == body ||
                p[-1] == '&'
            ) &&
            strncmp(
                p,
                key,
                key_len
            ) == 0
        ) {
            p += key_len;

            const char *end =
                strchr(
                    p,
                    '&'
                );

            size_t len =
                end
                    ? (size_t)(end - p)
                    : strlen(p);

            url_decode(
                output,
                output_size,
                p,
                len
            );

            return true;
        }

        p =
            strchr(
                p,
                '&'
            );

        if (!p)
            break;

        p++;
    }

    output[0] = '\0';

    return false;
}


/* ========================================================= */
/* Local multi-link queue                                    */
/* ========================================================= */

static bool append_pending(
    const char *link
)
{
    return downloader_enqueue(
        link
    );
}


static unsigned queue_multiple_links(
    char *links
)
{
    unsigned count = 0;

    char *p = links;

    while (*p) {
        char *start = p;

        while (
            *p &&
            *p != '\r' &&
            *p != '\n'
        ) {
            p++;
        }

        char saved = *p;
        *p = '\0';

        char *line =
            trim(start);

        if (line[0]) {
            if (
                append_pending(
                    line
                )
            ) {
                count++;
            }
        }

        if (!saved)
            break;

        p++;

        while (
            *p == '\r' ||
            *p == '\n'
        ) {
            p++;
        }
    }

    return count;
}


static bool first_link(
    char *links,
    char *output,
    size_t output_size
)
{
    char *p = links;

    while (*p) {
        while (
            *p == '\r' ||
            *p == '\n' ||
            *p == ' ' ||
            *p == '\t'
        ) {
            p++;
        }

        if (!*p)
            break;

        char *end = p;

        while (
            *end &&
            *end != '\r' &&
            *end != '\n'
        ) {
            end++;
        }

        size_t len =
            (size_t)(
                end - p
            );

        while (
            len > 0 &&
            (
                p[len - 1] == ' ' ||
                p[len - 1] == '\t'
            )
        ) {
            len--;
        }

        if (len > 0) {
            if (
                len >=
                output_size
            ) {
                len =
                    output_size - 1;
            }

            memcpy(
                output,
                p,
                len
            );

            output[len] = '\0';

            return true;
        }

        p = end;
    }

    output[0] = '\0';

    return false;
}


/* ========================================================= */
/* curl response buffer                                      */
/* ========================================================= */

typedef struct {
    char *data;
    size_t capacity;
    size_t size;
    bool overflow;
} ApiBuffer;


static size_t api_write_callback(
    char *ptr,
    size_t size,
    size_t nmemb,
    void *userdata
)
{
    ApiBuffer *buffer =
        (ApiBuffer *)userdata;

    size_t amount =
        size * nmemb;

    if (
        buffer->size +
        amount +
        1 >
        buffer->capacity
    ) {
        buffer->overflow =
            true;

        return 0;
    }

    memcpy(
        buffer->data +
        buffer->size,
        ptr,
        amount
    );

    buffer->size +=
        amount;

    buffer->data[
        buffer->size
    ] = '\0';

    return amount;
}


/* ========================================================= */
/* Tiny JSON helpers                                         */
/* ========================================================= */

static const char *skip_json_space(
    const char *p
)
{
    while (
        *p == ' ' ||
        *p == '\t' ||
        *p == '\r' ||
        *p == '\n'
    ) {
        p++;
    }

    return p;
}


static bool json_string(
    const char *json,
    const char *key,
    char *output,
    size_t output_size
)
{
    char needle[128];

    snprintf(
        needle,
        sizeof(needle),
        "\"%s\"",
        key
    );

    const char *p =
        strstr(
            json,
            needle
        );

    if (!p)
        return false;

    p += strlen(needle);

    p =
        skip_json_space(p);

    if (*p != ':')
        return false;

    p++;

    p =
        skip_json_space(p);

    if (*p != '"')
        return false;

    p++;

    size_t out = 0;

    while (
        *p &&
        *p != '"' &&
        out + 1 <
        output_size
    ) {
        if (*p == '\\') {
            p++;

            if (!*p)
                break;

            switch (*p) {
                case '"':
                    output[out++] = '"';
                    break;

                case '\\':
                    output[out++] = '\\';
                    break;

                case '/':
                    output[out++] = '/';
                    break;

                case 'n':
                    output[out++] = '\n';
                    break;

                case 'r':
                    output[out++] = '\r';
                    break;

                case 't':
                    output[out++] = '\t';
                    break;

                case 'b':
                case 'f':
                    output[out++] = ' ';
                    break;

                case 'u':
                    /*
                     * Good enough for the API test.
                     * Full UTF-8 JSON decoding can come later.
                     */
                    output[out++] = '?';

                    for (
                        int i = 0;
                        i < 4 &&
                        p[1];
                        i++
                    ) {
                        p++;
                    }

                    break;

                default:
                    output[out++] =
                        *p;
                    break;
            }

            p++;
            continue;
        }

        output[out++] =
            *p++;
    }

    output[out] = '\0';

    return true;
}


static bool json_integer(
    const char *json,
    const char *key,
    unsigned long long *value
)
{
    char needle[128];

    snprintf(
        needle,
        sizeof(needle),
        "\"%s\"",
        key
    );

    const char *p =
        strstr(
            json,
            needle
        );

    if (!p)
        return false;

    p += strlen(needle);

    p =
        skip_json_space(p);

    if (*p != ':')
        return false;

    p++;

    p =
        skip_json_space(p);

    if (
        *p < '0' ||
        *p > '9'
    ) {
        return false;
    }

    *value =
        strtoull(
            p,
            NULL,
            10
        );

    return true;
}


static bool json_success(
    const char *json
)
{
    char status[32];

    if (
        !json_string(
            json,
            "status",
            status,
            sizeof(status)
        )
    ) {
        return false;
    }

    return
        strcmp(
            status,
            "success"
        ) == 0;
}


/* ========================================================= */
/* AllDebrid                                                 */
/* ========================================================= */

static struct curl_slist *
make_alldebrid_headers(void)
{
    if (!g_alldebrid_token[0])
        return NULL;

    char authorization[1200];

    snprintf(
        authorization,
        sizeof(authorization),
        "Authorization: Bearer %s",
        g_alldebrid_token
    );

    struct curl_slist *headers =
        NULL;

    headers =
        curl_slist_append(
            headers,
            authorization
        );

    headers =
        curl_slist_append(
            headers,
            "Content-Type: application/x-www-form-urlencoded"
        );

    return headers;
}


static void configure_curl_common(
    CURL *curl
)
{
    curl_easy_setopt(
        curl,
        CURLOPT_CONNECTTIMEOUT,
        15L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_TIMEOUT,
        30L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_NOSIGNAL,
        1L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_HTTP_VERSION,
        CURL_HTTP_VERSION_1_1
    );

    curl_easy_setopt(
        curl,
        CURLOPT_SSL_VERIFYPEER,
        1L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_SSL_VERIFYHOST,
        2L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_USERAGENT,
        g_alldebrid_name[0]
            ? g_alldebrid_name
            : "SwitchDebridDownloader"
    );
}


static bool alldebrid_auth_test(
    long *http_status,
    CURLcode *curl_result
)
{
    *http_status = 0;

    *curl_result =
        CURLE_FAILED_INIT;

    if (!g_alldebrid_token[0])
        return false;

    CURL *curl =
        curl_easy_init();

    if (!curl)
        return false;

    struct curl_slist *headers =
        make_alldebrid_headers();

    ApiBuffer response = {
        .data = g_api_body,
        .capacity =
            sizeof(g_api_body),
        .size = 0,
        .overflow = false
    };

    g_api_body[0] = '\0';

    curl_easy_setopt(
        curl,
        CURLOPT_URL,
        "https://api.alldebrid.com/v4/user"
    );

    curl_easy_setopt(
        curl,
        CURLOPT_HTTPHEADER,
        headers
    );

    curl_easy_setopt(
        curl,
        CURLOPT_WRITEFUNCTION,
        api_write_callback
    );

    curl_easy_setopt(
        curl,
        CURLOPT_WRITEDATA,
        &response
    );

    configure_curl_common(
        curl
    );

    *curl_result =
        curl_easy_perform(
            curl
        );

    curl_easy_getinfo(
        curl,
        CURLINFO_RESPONSE_CODE,
        http_status
    );

    curl_easy_cleanup(
        curl
    );

    if (headers)
        curl_slist_free_all(
            headers
        );

    return
        *curl_result ==
            CURLE_OK &&
        *http_status ==
            200 &&
        !response.overflow &&
        json_success(
            g_api_body
        );
}


typedef struct {
    bool success;
    bool direct_ready;

    long http_status;
    CURLcode curl_result;

    char filename[1024];
    unsigned long long filesize;

    char direct_link[8192];

    unsigned long long delayed;

    char error_code[128];
    char error_message[512];
} UnlockResult;


static void alldebrid_unlock(
    const char *link,
    UnlockResult *result
)
{
    memset(
        result,
        0,
        sizeof(*result)
    );

    result->curl_result =
        CURLE_FAILED_INIT;

    if (!g_alldebrid_token[0]) {
        snprintf(
            result->error_message,
            sizeof(result->error_message),
            "AllDebrid token is not configured."
        );

        return;
    }

    CURL *curl =
        curl_easy_init();

    if (!curl) {
        snprintf(
            result->error_message,
            sizeof(result->error_message),
            "curl_easy_init failed."
        );

        return;
    }

    char *escaped =
        curl_easy_escape(
            curl,
            link,
            0
        );

    if (!escaped) {
        snprintf(
            result->error_message,
            sizeof(result->error_message),
            "Could not URL-encode the link."
        );

        curl_easy_cleanup(
            curl
        );

        return;
    }

    size_t post_size =
        strlen(escaped) +
        16;

    char *post_data =
        malloc(post_size);

    if (!post_data) {
        curl_free(
            escaped
        );

        curl_easy_cleanup(
            curl
        );

        snprintf(
            result->error_message,
            sizeof(result->error_message),
            "Out of memory."
        );

        return;
    }

    snprintf(
        post_data,
        post_size,
        "link=%s",
        escaped
    );

    curl_free(
        escaped
    );

    struct curl_slist *headers =
        make_alldebrid_headers();

    ApiBuffer response = {
        .data = g_api_body,
        .capacity =
            sizeof(g_api_body),
        .size = 0,
        .overflow = false
    };

    g_api_body[0] = '\0';

    curl_easy_setopt(
        curl,
        CURLOPT_URL,
        "https://api.alldebrid.com/v4/link/unlock"
    );

    curl_easy_setopt(
        curl,
        CURLOPT_HTTPHEADER,
        headers
    );

    curl_easy_setopt(
        curl,
        CURLOPT_POST,
        1L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_POSTFIELDS,
        post_data
    );

    curl_easy_setopt(
        curl,
        CURLOPT_POSTFIELDSIZE,
        (long)strlen(post_data)
    );

    curl_easy_setopt(
        curl,
        CURLOPT_WRITEFUNCTION,
        api_write_callback
    );

    curl_easy_setopt(
        curl,
        CURLOPT_WRITEDATA,
        &response
    );

    configure_curl_common(
        curl
    );

    result->curl_result =
        curl_easy_perform(
            curl
        );

    curl_easy_getinfo(
        curl,
        CURLINFO_RESPONSE_CODE,
        &result->http_status
    );

    free(
        post_data
    );

    curl_easy_cleanup(
        curl
    );

    if (headers)
        curl_slist_free_all(
            headers
        );

    if (
        result->curl_result !=
            CURLE_OK
    ) {
        snprintf(
            result->error_message,
            sizeof(result->error_message),
            "curl error %d",
            (int)result->curl_result
        );

        return;
    }

    if (response.overflow) {
        snprintf(
            result->error_message,
            sizeof(result->error_message),
            "API response was too large."
        );

        return;
    }

    if (
        result->http_status !=
            200 ||
        !json_success(
            g_api_body
        )
    ) {
        json_string(
            g_api_body,
            "code",
            result->error_code,
            sizeof(result->error_code)
        );

        json_string(
            g_api_body,
            "message",
            result->error_message,
            sizeof(result->error_message)
        );

        if (
            !result->
                error_message[0]
        ) {
            snprintf(
                result->error_message,
                sizeof(result->error_message),
                "AllDebrid returned HTTP %ld.",
                result->http_status
            );
        }

        return;
    }

    result->success = true;

    json_string(
        g_api_body,
        "filename",
        result->filename,
        sizeof(result->filename)
    );

    json_integer(
        g_api_body,
        "filesize",
        &result->filesize
    );

    json_integer(
        g_api_body,
        "delayed",
        &result->delayed
    );

    if (
        json_string(
            g_api_body,
            "link",
            result->direct_link,
            sizeof(result->direct_link)
        ) &&
        result->direct_link[0]
    ) {
        result->direct_ready =
            true;
    }
}


/* ========================================================= */
/* HTML                                                      */
/* ========================================================= */

static void html_escape(
    const char *input,
    char *output,
    size_t output_size
)
{
    size_t used = 0;

    while (
        *input &&
        used + 1 <
        output_size
    ) {
        const char *replacement =
            NULL;

        switch (*input) {
            case '&':
                replacement = "&amp;";
                break;

            case '<':
                replacement = "&lt;";
                break;

            case '>':
                replacement = "&gt;";
                break;

            case '"':
                replacement = "&quot;";
                break;

            default:
                break;
        }

        if (replacement) {
            size_t len =
                strlen(
                    replacement
                );

            if (
                used + len >=
                output_size
            ) {
                break;
            }

            memcpy(
                output + used,
                replacement,
                len
            );

            used += len;
        }
        else {
            output[used++] =
                *input;
        }

        input++;
    }

    output[used] = '\0';
}



static bool get_session_cookie(
    const char *request,
    char *output,
    size_t output_size
)
{
    const char *headers_end =
        strstr(
            request,
            "\r\n\r\n"
        );

    if (!headers_end)
        return false;

    const char *p =
        strstr(
            request,
            "SDDSESSION="
        );

    if (
        !p ||
        p >= headers_end
    ) {
        return false;
    }

    p +=
        strlen(
            "SDDSESSION="
        );

    size_t n = 0;

    while (
        p < headers_end &&
        *p &&
        *p != ';' &&
        *p != '\r' &&
        *p != '\n' &&
        *p != ' ' &&
        n + 1 < output_size
    ) {
        output[n++] =
            *p++;
    }

    output[n] = '\0';

    return n > 0;
}


