/* ========================================================= */
/* HTTP reader                                               */
/* ========================================================= */

static ssize_t read_request(
    int fd
)
{
    size_t used = 0;

    while (
        used + 1 <
        sizeof(g_request)
    ) {
        ssize_t n =
            recv(
                fd,
                g_request + used,
                sizeof(g_request)
                    - used - 1,
                0
            );

        if (n <= 0)
            break;

        used +=
            (size_t)n;

        g_request[used] =
            '\0';

        char *headers_end =
            strstr(
                g_request,
                "\r\n\r\n"
            );

        if (!headers_end)
            continue;

        if (
            strncmp(
                g_request,
                "GET ",
                4
            ) == 0
        ) {
            break;
        }

        const char *cl =
            strstr(
                g_request,
                "Content-Length:"
            );

        if (!cl) {
            cl =
                strstr(
                    g_request,
                    "content-length:"
                );
        }

        if (cl) {
            size_t content_length =
                strtoul(
                    cl + 15,
                    NULL,
                    10
                );

            size_t header_length =
                (size_t)(
                    headers_end +
                    4 -
                    g_request
                );

            if (
                used >=
                header_length +
                content_length
            ) {
                break;
            }
        }
        else {
            break;
        }
    }

    g_request[used] =
        '\0';

    return
        (ssize_t)used;
}


/* ========================================================= */
/* Routes                                                    */
/* ========================================================= */

static void handle_client(
    int fd,
    const char *client_ip
)
{
    if (
        read_request(
            fd
        ) <= 0
    ) {
        return;
    }

    /*
     * /login is deliberately the only unauthenticated
     * action.
     */
    if (
        strncmp(
            g_request,
            "POST /login ",
            12
        ) == 0
    ) {
        char *body =
            strstr(
                g_request,
                "\r\n\r\n"
            );

        if (!body) {
            send_login_page(
                fd,
                "Invalid login request."
            );

            return;
        }

        body += 4;

        char password[256] = {0};

        form_value(
            body,
            "password",
            password,
            sizeof(password)
        );

        bool valid =
            remote_auth_verify(
                password
            );

        memset(
            password,
            0,
            sizeof(password)
        );

        if (!valid) {
            /*
             * Slow down simple brute-force attempts.
             */
            svcSleepThread(
                1500LL *
                1000LL *
                1000LL
            );

            send_login_page(
                fd,
                "Incorrect password."
            );

            return;
        }

        char session[65];

        if (
            !remote_auth_create_session(
                client_ip,
                session,
                sizeof(session)
            )
        ) {
            send_login_page(
                fd,
                "Could not create session."
            );

            return;
        }

        send_login_success(
            fd,
            session
        );

        memset(
            session,
            0,
            sizeof(session)
        );

        return;
    }


    char session[65] = {0};

    bool authenticated =
        get_session_cookie(
            g_request,
            session,
            sizeof(session)
        ) &&
        remote_auth_session_valid(
            session,
            client_ip
        );

    if (!authenticated) {
        send_login_page(
            fd,
            "Enter the remote access password."
        );

        return;
    }


    if (
        strncmp(
            g_request,
            "GET /logout ",
            12
        ) == 0
    ) {
        remote_auth_revoke_session(
            session,
            client_ip
        );

        send_logout(
            fd
        );

        return;
    }


    if (
        strncmp(
            g_request,
            "GET /alldebrid-connect ",
            23
        ) == 0
    ) {
        if (g_alldebrid_connected) {
            send_page(
                fd,
                "AllDebrid is already connected."
            );

            return;
        }

        char error[512] = {0};

        if (
            !alldebrid_pin_start(
                error,
                sizeof(error)
            )
        ) {
            send_page(
                fd,
                error[0]
                    ? error
                    : "Could not start AllDebrid PIN authentication."
            );

            return;
        }

        send_alldebrid_pin_page(
            fd,
            "Enter this PIN on AllDebrid."
        );

        return;
    }


    if (
        strncmp(
            g_request,
            "GET /alldebrid-pin-check ",
            25
        ) == 0
    ) {
        if (
            !alldebrid_pin_pending()
        ) {
            send_page(
                fd,
                g_alldebrid_connected
                    ? "AllDebrid is connected."
                    : "No AllDebrid PIN authentication is active."
            );

            return;
        }

        bool activated = false;
        char apikey[1024] = {0};
        char error[512] = {0};

        bool ok =
            alldebrid_pin_check(
                &activated,
                apikey,
                sizeof(apikey),
                error,
                sizeof(error)
            );

        if (!ok) {
            memset(
                apikey,
                0,
                sizeof(apikey)
            );

            send_page(
                fd,
                error[0]
                    ? error
                    : "AllDebrid PIN check failed."
            );

            return;
        }

        if (!activated) {
            send_alldebrid_pin_page(
                fd,
                "Waiting for AllDebrid approval..."
            );

            return;
        }

        downloader_set_token(
            apikey
        );

        memset(
            apikey,
            0,
            sizeof(apikey)
        );

        g_alldebrid_connected =
            true;

        alldebrid_pin_reset();

        send_page(
            fd,
            "AllDebrid connected successfully. "
            "The API key is stored in RAM only."
        );

        return;
    }


    if (
        strncmp(
            g_request,
            "GET /alldebrid-disconnect ",
            26
        ) == 0
    ) {
        downloader_set_token(
            ""
        );

        g_alldebrid_connected =
            false;

        alldebrid_pin_reset();

        send_page(
            fd,
            "AllDebrid disconnected. "
            "The session API key was cleared from RAM."
        );

        return;
    }



    if (
        strncmp(
            g_request,
            "GET /status ",
            12
        ) == 0
    ) {
        send_status_json(
            fd
        );

        return;
    }


    if (
        strncmp(
            g_request,
            "GET / ",
            6
        ) == 0
    ) {
        send_page(
            fd,
            "Ready."
        );

        return;
    }

    if (
        strncmp(
            g_request,
            "GET /reload-config ",
            19
        ) == 0
    ) {
        load_config();

    /*
     * AllDebrid authentication is session-only.
     * Ignore any legacy token still present in config.ini.
     */
    g_alldebrid_token[0] = '\0';

        send_redirect(
            fd
        );

        return;
    }

    if (
