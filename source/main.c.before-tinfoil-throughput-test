/* ========================================================= */
/* Main                                                      */
/* ========================================================= */

int main(
    int argc,
    char **argv
)
{
    (void)argc;
    (void)argv;

    consoleInit(NULL);

    padConfigureInput(
        1,
        HidNpadStyleSet_NpadStandard
    );

    PadState pad;
    padInitializeDefault(&pad);

    printf(
        "Switch Debrid Downloader\n"
        "Stage 2B - AllDebrid Unlock Test\n\n"
    );

    load_config();

    if (
        !remote_auth_ensure_password()
    ) {
        printf(
            "\nRemote password setup failed "
            "or was cancelled.\n"
            "Press + to exit.\n"
        );

        consoleUpdate(NULL);

        while (
            appletMainLoop()
        ) {
            padUpdate(&pad);

            if (
                padGetButtonsDown(&pad) &
                HidNpadButton_Plus
            ) {
                break;
            }
        }

        consoleExit(NULL);
        return 0;
    }

    printf(
        "\nRemote password ready.\n"
    );

    consoleUpdate(NULL);

    /*
     * Larger TCP receive window for high-bandwidth,
     * higher-latency downloads.
     *
     * Preserve every other libnx default setting.
     */
    /*
     * Socket configuration matched to the uploaded
     * Tinfoil 20.0 NRO defaults.
     */
    SocketInitConfig socket_config =
        *socketGetDefaultInitConfig();

    socket_config.tcp_tx_buf_size =
        0x40000;   /* 256 KiB */

    socket_config.tcp_rx_buf_size =
        0x40000;   /* 256 KiB */

    socket_config.tcp_tx_buf_max_size =
        0x80000;   /* 512 KiB */

    socket_config.tcp_rx_buf_max_size =
        0x80000;   /* 512 KiB */

    socket_config.udp_tx_buf_size =
        0x2400;

    socket_config.udp_rx_buf_size =
        0xA500;

    socket_config.sb_efficiency =
        4;

    socket_config.num_bsd_sessions =
        8;

    socket_config.bsd_service_type =
        BsdServiceType_User;

    Result rc =
        socketInitialize(
            &socket_config
        );

    if (R_FAILED(rc)) {
        printf(
            "Network init failed: "
            "0x%08X\n",
            rc
        );

        consoleUpdate(NULL);

        while (
            appletMainLoop()
        ) {
            padUpdate(
                &pad
            );

            if (
                padGetButtonsDown(
                    &pad
                ) &
                HidNpadButton_Plus
            ) {
                break;
            }
        }

        consoleExit(NULL);

        return 0;
    }

    CURLcode curl_init =
        curl_global_init(
            CURL_GLOBAL_DEFAULT
        );

    if (
        curl_init !=
        CURLE_OK
    ) {
        printf(
            "curl init failed: %d\n",
            (int)curl_init
        );

        consoleUpdate(NULL);

        while (
            appletMainLoop()
        ) {
            padUpdate(
                &pad
            );

            if (
                padGetButtonsDown(
                    &pad
                ) &
                HidNpadButton_Plus
            ) {
                break;
            }
        }

        socketExit();
        consoleExit(NULL);

        return 0;
    }

    if (
        !downloader_init(
            "",
            g_alldebrid_name,
            g_max_concurrent
        )
    ) {
        printf(
            "Downloader worker startup failed.\n"
        );

        consoleUpdate(NULL);

        curl_global_cleanup();
        socketExit();
        consoleExit(NULL);

        return 0;
    }

    int server =
        socket(
            AF_INET,
            SOCK_STREAM,
            0
        );

    if (server < 0) {
        printf(
            "socket failed: %d\n",
            errno
        );

        curl_global_cleanup();
        socketExit();
        consoleExit(NULL);

        return 0;
    }

    int yes = 1;

    setsockopt(
        server,
        SOL_SOCKET,
        SO_REUSEADDR,
        &yes,
        sizeof(yes)
    );

    struct sockaddr_in addr;

    memset(
        &addr,
        0,
        sizeof(addr)
    );

    addr.sin_family =
        AF_INET;

    addr.sin_port =
        htons(PORT);

    addr.sin_addr.s_addr =
        INADDR_ANY;

    if (
        bind(
            server,
            (struct sockaddr *)&addr,
            sizeof(addr)
        ) != 0 ||
        listen(
            server,
            8
        ) != 0
    ) {
        printf(
            "Server startup failed: %d\n",
            errno
        );

        consoleUpdate(NULL);

        while (
            appletMainLoop()
        ) {
            padUpdate(
                &pad
            );

            if (
                padGetButtonsDown(
                    &pad
                ) &
                HidNpadButton_Plus
            ) {
                break;
            }
        }

        close(server);
        downloader_shutdown();
        curl_global_cleanup();
        socketExit();
        consoleExit(NULL);

        return 0;
    }

    printf(
        "READY\n\n"
        "Phone:\n"
        "http://SWITCH-IP:%d\n\n"

        "AllDebrid token: %s\n"
        "Max concurrent: %d\n\n"

        "Press + to exit.\n",

        PORT,

        g_alldebrid_token[0]
            ? "loaded"
            : "not configured",

        g_max_concurrent
    );

    consoleUpdate(NULL);

    while (
        appletMainLoop()
    ) {
        padUpdate(
            &pad
        );

        if (
            padGetButtonsDown(
                &pad
            ) &
            HidNpadButton_Plus
        ) {
            break;
        }

        fd_set fds;

        FD_ZERO(
            &fds
        );

        FD_SET(
            server,
            &fds
        );

        struct timeval tv = {
            .tv_sec = 0,
            .tv_usec = 100000
        };

        int ready =
            select(
                server + 1,
                &fds,
                NULL,
                NULL,
                &tv
            );

        if (
            ready > 0 &&
            FD_ISSET(
                server,
                &fds
            )
        ) {
            struct sockaddr_in client_addr;
            socklen_t client_addr_len =
                sizeof(client_addr);

            memset(
                &client_addr,
                0,
                sizeof(client_addr)
            );

            int client =
                accept(
                    server,
                    (struct sockaddr *)&client_addr,
                    &client_addr_len
                );

            char client_ip[
                INET_ADDRSTRLEN
            ] = {0};

            if (
                client >= 0
            ) {
                if (
                    !inet_ntop(
                        AF_INET,
                        &client_addr.sin_addr,
                        client_ip,
                        sizeof(client_ip)
                    )
                ) {
                    snprintf(
                        client_ip,
                        sizeof(client_ip),
                        "unknown"
                    );
                }
                struct timeval timeout;

                timeout.tv_sec = 35;
                timeout.tv_usec = 0;

                setsockopt(
                    client,
                    SOL_SOCKET,
                    SO_RCVTIMEO,
                    &timeout,
                    sizeof(timeout)
                );

                setsockopt(
                    client,
                    SOL_SOCKET,
                    SO_SNDTIMEO,
                    &timeout,
                    sizeof(timeout)
                );

                handle_client(
                    client,
                    client_ip
                );

                close(
                    client
                );
            }
        }
    }

    close(
        server
    );

    alldebrid_pin_reset();

    downloader_set_token(
        ""
    );

    g_alldebrid_connected =
        false;

    remote_auth_revoke_all();

    downloader_shutdown();

    curl_global_cleanup();

    socketExit();

    consoleExit(NULL);

    return 0;
}
