static int send_all(
    int fd,
    const void *buffer,
    size_t length
)
{
    const char *p =
        (const char *)buffer;

    while (length > 0) {
        ssize_t n =
            send(
                fd,
                p,
                length,
                0
            );

        if (n <= 0)
            return -1;

        p += n;
        length -= (size_t)n;
    }

    return 0;
}


static int hex_value(char c)
{
    if (c >= '0' && c <= '9')
        return c - '0';

    if (c >= 'a' && c <= 'f')
        return c - 'a' + 10;

    if (c >= 'A' && c <= 'F')
        return c - 'A' + 10;

    return -1;
}


static char *trim(char *s)
{
    while (
        *s == ' ' ||
        *s == '\t' ||
        *s == '\r' ||
        *s == '\n'
    ) {
        s++;
    }

    size_t len =
        strlen(s);

    while (
        len > 0 &&
        (
            s[len - 1] == ' ' ||
            s[len - 1] == '\t' ||
            s[len - 1] == '\r' ||
            s[len - 1] == '\n'
        )
    ) {
        s[--len] = '\0';
    }

    return s;
}


