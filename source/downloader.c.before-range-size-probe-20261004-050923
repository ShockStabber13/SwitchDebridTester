static void sanitize_filename(
    char *name
)
{
    if (!name[0]) {
        snprintf(
            name,
            1024,
            "download.bin"
        );

        return;
    }

    for (
        char *p = name;
        *p;
        p++
    ) {
        unsigned char c =
            (unsigned char)*p;

        if (
            c < 32 ||
            *p == '/' ||
            *p == '\\' ||
            *p == ':' ||
            *p == '*' ||
            *p == '?' ||
            *p == '"' ||
            *p == '<' ||
            *p == '>' ||
            *p == '|'
        ) {
            *p = '_';
        }
    }
}


static void choose_output_path(
    const char *filename,
    char *final_path,
    size_t final_size,
    char *part_path,
    size_t part_size
)
{
    snprintf(
        final_path,
        final_size,
        "%s/%s",
        DOWNLOAD_DIR,
        filename
    );

    struct stat st;

    if (
        stat(
            final_path,
            &st
        ) == 0
    ) {
        for (
            int i = 2;
            i < 1000;
            i++
        ) {
            snprintf(
                final_path,
                final_size,
                "%s/%s.%d",
                DOWNLOAD_DIR,
                filename,
                i
            );

            if (
                stat(
                    final_path,
                    &st
                ) != 0
            ) {
                break;
            }
        }
    }

    snprintf(
        part_path,
        part_size,
        "%s.part",
        final_path
    );
}



/* ========================================================= */
/* Async SD writer                                           */
/* ========================================================= */

static void async_writer_thread(
    void *arg
)
{
    AsyncWriter *writer =
        (AsyncWriter *)arg;

    while (true) {
        size_t amount = 0;
        size_t read_pos = 0;
        bool done = false;
        bool failed = false;

        mutexLock(
            &writer->mutex
        );

        done =
            writer->producer_done;

        failed =
            writer->failed;

        /*
         * Prefer large SD writes while downloading.
         * When the network finishes, flush whatever remains.
         */
        if (
            !failed &&
            writer->queued > 0 &&
            (
                done ||
                writer->queued >=
                    ASYNC_WRITE_CHUNK_SIZE
            )
        ) {
            amount =
                writer->queued;

            if (
                amount >
                ASYNC_WRITE_CHUNK_SIZE
            ) {
                amount =
                    ASYNC_WRITE_CHUNK_SIZE;
            }

            read_pos =
                writer->read_pos;

            size_t contiguous =
                writer->capacity -
                read_pos;

            if (
                amount >
                contiguous
            ) {
                amount =
                    contiguous;
            }
        }

        size_t queued_now =
            writer->queued;

        mutexUnlock(
            &writer->mutex
        );

        if (failed) {
            break;
        }

        if (amount == 0) {
            if (
                done &&
                queued_now == 0
            ) {
                break;
            }

            /*
             * 1 ms wait.
             *
             * Keeps this simple and avoids making the curl
             * thread perform SD writes.
             */
            svcSleepThread(
                1000000L
            );

            continue;
        }

        size_t written =
            fwrite(
                writer->buffer +
                    read_pos,
                1,
                amount,
                writer->file
            );

        if (written != amount) {
            mutexLock(
                &writer->mutex
            );

            writer->failed =
                true;

            mutexUnlock(
                &writer->mutex
            );

            break;
        }

        mutexLock(
            &writer->mutex
        );

        writer->read_pos =
            (
                writer->read_pos +
                amount
            ) %
            writer->capacity;

        writer->queued -=
            amount;

        mutexUnlock(
            &writer->mutex
        );
    }
}


static bool async_writer_start(
    AsyncWriter *writer,
    FILE *file,
    char *error,
    size_t error_size
)
{
    memset(
        writer,
        0,
        sizeof(*writer)
    );

    writer->file =
        file;

    writer->capacity =
        ASYNC_WRITE_BUFFER_SIZE;

    writer->buffer =
        malloc(
            writer->capacity
        );

    if (!writer->buffer) {
        snprintf(
            error,
            error_size,
            "Could not allocate 16 MiB async download buffer"
        );

        return false;
    }

    mutexInit(
        &writer->mutex
    );

    /*
     * Our own queue provides the buffering.
     * Disable stdio's second buffering layer.
     */
    if (
        setvbuf(
            file,
            NULL,
            _IONBF,
            0
        ) != 0
    ) {
        free(
            writer->buffer
        );

        writer->buffer = NULL;

        snprintf(
            error,
            error_size,
            "Could not configure async output file"
        );

        return false;
    }

    Result rc =
        threadCreate(
            &writer->thread,
            async_writer_thread,
            writer,
            NULL,
            0x20000,
            0x3B,
            -2
        );

    if (R_FAILED(rc)) {
        free(
            writer->buffer
        );

        writer->buffer = NULL;

        snprintf(
            error,
            error_size,
            "Could not create SD writer thread"
        );

        return false;
    }

    rc =
        threadStart(
            &writer->thread
        );

    if (R_FAILED(rc)) {
        threadClose(
            &writer->thread
        );

        free(
            writer->buffer
        );

        writer->buffer = NULL;

        snprintf(
            error,
            error_size,
            "Could not start SD writer thread"
        );

        return false;
    }

    writer->thread_started =
        true;

    return true;
}


static size_t async_writer_enqueue(
    AsyncWriter *writer,
    const char *data,
    size_t bytes
)
{
    if (
        !writer ||
        !writer->buffer ||
        !data
    ) {
        return 0;
    }

    size_t consumed = 0;

    while (consumed < bytes) {
        mutexLock(
            &writer->mutex
        );

        if (writer->failed) {
            mutexUnlock(
                &writer->mutex
            );

            return consumed;
        }

        size_t available =
            writer->capacity -
            writer->queued;

        if (available == 0) {
            mutexUnlock(
                &writer->mutex
            );

            /*
             * The network only waits when the entire
             * 16 MiB queue is full.
             */
            svcSleepThread(
                1000000L
            );

            continue;
        }

        size_t remaining =
            bytes -
            consumed;

        size_t amount =
            remaining < available
                ? remaining
                : available;

        size_t contiguous =
            writer->capacity -
            writer->write_pos;

        if (amount > contiguous) {
            amount =
                contiguous;
        }

        memcpy(
            writer->buffer +
                writer->write_pos,
            data +
                consumed,
            amount
        );

        writer->write_pos =
            (
                writer->write_pos +
                amount
            ) %
            writer->capacity;

        writer->queued +=
            amount;

        mutexUnlock(
            &writer->mutex
        );

        consumed +=
            amount;
    }

    return bytes;
}


static bool async_writer_finish(
    AsyncWriter *writer
)
{
    if (
        !writer ||
        !writer->buffer
    ) {
        return false;
    }

    mutexLock(
        &writer->mutex
    );

    writer->producer_done =
        true;

    mutexUnlock(
        &writer->mutex
    );

    if (
        writer->thread_started
    ) {
        (void)threadWaitForExit(
            &writer->thread
        );

        threadClose(
            &writer->thread
        );

        writer->thread_started =
            false;
    }

    mutexLock(
        &writer->mutex
    );

    bool ok =
        !writer->failed &&
        writer->queued == 0;

    mutexUnlock(
        &writer->mutex
    );

    if (
        fflush(
            writer->file
        ) != 0
    ) {
        ok = false;
    }

    free(
        writer->buffer
    );

    writer->buffer = NULL;

    return ok;
}


static size_t buffered_file_write(
    FILE *file,
    unsigned char *buffer,
    size_t *used,
    size_t capacity,
    bool *failed,
    const char *data,
    size_t bytes
)
{
    if (
        !file ||
        !buffer ||
        !used ||
        !failed ||
        capacity == 0 ||
        *failed
    ) {
        return 0;
    }

    size_t consumed = 0;

    while (consumed < bytes) {
        size_t available =
            capacity - *used;

        size_t remaining =
            bytes - consumed;

        size_t copy =
            remaining < available
                ? remaining
                : available;

        memcpy(
            buffer + *used,
            data + consumed,
            copy
        );

        *used += copy;
        consumed += copy;

        if (*used == capacity) {
            if (
                fwrite(
                    buffer,
                    1,
                    *used,
                    file
                ) != *used
            ) {
                *failed = true;
                return 0;
            }

            *used = 0;
        }
    }

    return bytes;
}


static bool buffered_file_flush(
    FILE *file,
    unsigned char *buffer,
    size_t *used,
    bool *failed
)
{
    if (
        !file ||
        !buffer ||
        !used ||
        !failed ||
        *failed
    ) {
        return false;
    }

    if (*used > 0) {
        if (
            fwrite(
                buffer,
                1,
                *used,
                file
            ) != *used
        ) {
            *failed = true;
            return false;
        }

        *used = 0;
    }

    return true;
}


static size_t file_write_callback(
    char *ptr,
    size_t size,
    size_t nmemb,
    void *userdata
)
{
    DownloadContext *ctx =
        (DownloadContext *)userdata;

    size_t bytes =
        size * nmemb;

    if (
        !ctx ||
        !ctx->async_writer ||
        !ctx->io_buffer ||
        ctx->io_capacity == 0 ||
        ctx->io_failed
    ) {
        return 0;
    }

    size_t consumed = 0;

    while (consumed < bytes) {
        size_t available =
            ctx->io_capacity -
            ctx->io_used;

        size_t remaining =
            bytes -
            consumed;

        size_t amount =
            remaining < available
                ? remaining
                : available;

        memcpy(
            ctx->io_buffer +
                ctx->io_used,
            ptr +
                consumed,
            amount
        );

        ctx->io_used +=
            amount;

        consumed +=
            amount;

        /*
         * Preserve the old proven behaviour:
         * accumulate a full 1 MiB first.
         *
         * Difference: instead of fwrite() here,
         * hand the 1 MiB block to the asynchronous
         * RAM -> SD writer.
         */
        if (
            ctx->io_used ==
            ctx->io_capacity
        ) {
            size_t queued =
                async_writer_enqueue(
                    ctx->async_writer,
                    (const char *)
                        ctx->io_buffer,
                    ctx->io_used
                );

            if (
                queued !=
                ctx->io_used
            ) {
                ctx->io_failed =
                    true;

                return consumed;
            }

            ctx->io_used = 0;
        }
    }

    return bytes;
}

static int progress_callback(
    void *clientp,
    curl_off_t dltotal,
    curl_off_t dlnow,
    curl_off_t ultotal,
    curl_off_t ulnow
)
{
    (void)ultotal;
    (void)ulnow;

    DownloadContext *ctx =
        (DownloadContext *)clientp;

    mutexLock(
        &g_mutex
    );

    g_worker_progress[
        ctx->worker_index
    ].downloaded =
        dlnow >= 0
            ? (unsigned long long)dlnow
            : 0;

    g_worker_progress[
        ctx->worker_index
    ].total =
        dltotal >= 0
            ? (unsigned long long)dltotal
            : 0;

    struct timespec now;

    clock_gettime(
        CLOCK_MONOTONIC,
        &now
    );

    WorkerProgress *wp =
        &g_worker_progress[
            ctx->worker_index
        ];

    if (
        wp->last_time.tv_sec != 0 ||
        wp->last_time.tv_nsec != 0
    ) {
        double elapsed =
            (double)(
                now.tv_sec -
                wp->last_time.tv_sec
            ) +
            (double)(
                now.tv_nsec -
                wp->last_time.tv_nsec
            ) /
            1000000000.0;

        if (elapsed >= 0.5) {
            unsigned long long current =
                dlnow >= 0
                    ? (unsigned long long)dlnow
                    : 0;

            unsigned long long delta =
                current >= wp->last_downloaded
                    ? current - wp->last_downloaded
                    : 0;

            wp->bytes_per_second =
                (unsigned long long)(
                    (double)delta /
                    elapsed
                );

            wp->last_downloaded =
                current;

            wp->last_time =
                now;
        }
    }
    else {
        wp->last_downloaded =
            dlnow >= 0
                ? (unsigned long long)dlnow
                : 0;

        wp->last_time =
            now;
    }

    mutexUnlock(
        &g_mutex
    );

    return
        g_running
            ? 0
            : 1;
}


/* ========================================================= */
/* Four-connection file downloader                           */
/* ========================================================= */

#define DOWNLOAD_SEGMENTS 3




typedef struct {
    int worker_index;
    unsigned long long total;
    unsigned long long segment_downloaded[DOWNLOAD_SEGMENTS];
} SegmentedDownloadState;


typedef struct {
    FILE *file;
    SegmentedDownloadState *state;
    int segment_index;

    unsigned char *io_buffer;
    size_t io_used;
    size_t io_capacity;
    bool io_failed;
} SegmentDownloadContext;


typedef struct {
    size_t received;
    size_t limit;
} RangeProbeContext;


static size_t range_probe_write(
    char *ptr,
    size_t size,
    size_t nmemb,
    void *userdata
)
{
    (void)ptr;

    RangeProbeContext *ctx =
        (RangeProbeContext *)userdata;

    size_t bytes =
        size * nmemb;

    if (
        bytes > ctx->limit -
        (
            ctx->received < ctx->limit
                ? ctx->received
                : ctx->limit
        )
    ) {
        return 0;
    }

    ctx->received += bytes;
    return bytes;
}


static bool server_supports_byte_ranges(
    const char *url
)
{
    CURL *curl =
        curl_easy_init();

    if (!curl)
        return false;

    RangeProbeContext probe = {
        .received = 0,
        .limit = 4096
    };

    curl_easy_setopt(
        curl,
        CURLOPT_URL,
        url
    );

    curl_easy_setopt(
        curl,
        CURLOPT_RANGE,
        "0-0"
    );

    curl_easy_setopt(
        curl,
        CURLOPT_FOLLOWLOCATION,
        1L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_MAXREDIRS,
        10L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_WRITEFUNCTION,
        range_probe_write
    );

    curl_easy_setopt(
        curl,
        CURLOPT_WRITEDATA,
        &probe
    );

    curl_easy_setopt(
        curl,
        CURLOPT_CONNECTTIMEOUT,
        30L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_TIMEOUT,
        30L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_NOSIGNAL,
        1L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_SSL_VERIFYPEER,
        1L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_SSL_VERIFYHOST,
        2L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_USERAGENT,
        g_user_agent[0]
            ? g_user_agent
            : "SwitchDebridDownloader"
    );

    /*
     * Do not consume one of the transfer connections from a
     * persistent pool. The real segmented transfer deliberately
     * starts four independent TCP connections below.
     */
    curl_easy_setopt(
        curl,
        CURLOPT_FRESH_CONNECT,
        1L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_FORBID_REUSE,
        1L
    );

    CURLcode rc =
        curl_easy_perform(
            curl
        );

    long http_status = 0;

    curl_easy_getinfo(
        curl,
        CURLINFO_RESPONSE_CODE,
        &http_status
    );

    curl_easy_cleanup(
        curl
    );

    return
        rc == CURLE_OK &&
        http_status == 206 &&
        probe.received == 1;
}


static size_t segment_file_write_callback(
    char *ptr,
    size_t size,
    size_t nmemb,
    void *userdata
)
{
    SegmentDownloadContext *ctx =
        (SegmentDownloadContext *)userdata;

    size_t bytes =
        size * nmemb;

    return
        buffered_file_write(
            ctx->file,
            ctx->io_buffer,
            &ctx->io_used,
            ctx->io_capacity,
            &ctx->io_failed,
            ptr,
            bytes
        );
}


static int segment_progress_callback(
    void *clientp,
    curl_off_t dltotal,
    curl_off_t dlnow,
    curl_off_t ultotal,
    curl_off_t ulnow
)
{
    (void)dltotal;
    (void)ultotal;
    (void)ulnow;

    SegmentDownloadContext *ctx =
        (SegmentDownloadContext *)clientp;

    SegmentedDownloadState *state =
        ctx->state;

    state->segment_downloaded[
        ctx->segment_index
    ] =
        dlnow >= 0
            ? (unsigned long long)dlnow
            : 0;

    unsigned long long aggregate = 0;

    for (
        int i = 0;
        i < DOWNLOAD_SEGMENTS;
        i++
    ) {
        aggregate +=
            state->segment_downloaded[i];
    }

    struct timespec now;

    clock_gettime(
        CLOCK_MONOTONIC,
        &now
    );

    mutexLock(
        &g_mutex
    );

    WorkerProgress *wp =
        &g_worker_progress[
            state->worker_index
        ];

    wp->downloaded =
        aggregate;

    wp->total =
        state->total;

    if (
        wp->last_time.tv_sec != 0 ||
        wp->last_time.tv_nsec != 0
    ) {
        double elapsed =
            (double)(
                now.tv_sec -
                wp->last_time.tv_sec
            ) +
            (double)(
                now.tv_nsec -
                wp->last_time.tv_nsec
            ) /
            1000000000.0;

        if (elapsed >= 0.5) {
            unsigned long long delta =
                aggregate >= wp->last_downloaded
                    ? aggregate - wp->last_downloaded
                    : 0;

            wp->bytes_per_second =
                (unsigned long long)(
                    (double)delta /
                    elapsed
                );

            wp->last_downloaded =
                aggregate;

            wp->last_time =
                now;
        }
    }
    else {
        wp->last_downloaded =
            aggregate;

        wp->last_time =
            now;
    }

    mutexUnlock(
        &g_mutex
    );

    return
        g_running
            ? 0
            : 1;
}


static void remove_segment_files(
    char paths[DOWNLOAD_SEGMENTS][2144]
)
{
    for (
        int i = 0;
        i < DOWNLOAD_SEGMENTS;
        i++
    ) {
        if (paths[i][0]) {
            remove(
                paths[i]
            );
        }
    }
}


static bool combine_segment_files(
    char paths[DOWNLOAD_SEGMENTS][2144],
    const char *part_path,
    char *error,
    size_t error_size
)
{
    FILE *out =
        fopen(
            part_path,
            "wb"
        );

    if (!out) {
        snprintf(
            error,
            error_size,
            "Could not create combined .part file"
        );

        return false;
    }

    const size_t buffer_size =
        DOWNLOAD_IO_BUFFER_SIZE;

    unsigned char *buffer =
        malloc(
            buffer_size
        );

    if (!buffer) {
        fclose(out);
        remove(part_path);

        snprintf(
            error,
            error_size,
            "Out of memory while combining segments"
        );

        return false;
    }

    bool ok = true;

    for (
        int i = 0;
        i < DOWNLOAD_SEGMENTS && ok;
        i++
    ) {
        FILE *in =
            fopen(
                paths[i],
                "rb"
            );

        if (!in) {
            ok = false;
            break;
        }

        while (ok) {
            size_t got =
                fread(
                    buffer,
                    1,
                    buffer_size,
                    in
                );

            if (got > 0) {
                if (
                    fwrite(
                        buffer,
                        1,
                        got,
                        out
                    ) != got
                ) {
                    ok = false;
                    break;
                }
            }

            if (got < buffer_size) {
                if (ferror(in))
                    ok = false;

                break;
            }
        }

        fclose(in);
    }

    free(buffer);

    if (fclose(out) != 0)
        ok = false;

    if (!ok) {
        remove(part_path);

        snprintf(
            error,
            error_size,
            "Could not combine downloaded segments"
        );

        return false;
    }

    return true;
}


static bool download_file_single(
    int worker_index,
    const UnlockResult *unlock,
    const char *part_path,
    const char *final_path,
    char *error,
    size_t error_size
)
{
    remove(
        part_path
    );

    FILE *file =
        fopen(
            part_path,
            "wb"
        );

    if (!file) {
        snprintf(
            error,
            error_size,
            "Could not create output file"
        );

        return false;
    }

    CURL *curl =
        curl_easy_init();

    if (!curl) {
        fclose(file);
        remove(part_path);

        snprintf(
            error,
            error_size,
            "curl_easy_init failed"
        );

        return false;
    }

    AsyncWriter writer;

    memset(
        &writer,
        0,
        sizeof(writer)
    );

    DownloadContext ctx = {
        .file = file,
        .async_writer = &writer,
        .worker_index =
            worker_index,

        .io_buffer = NULL,
        .io_used = 0,
        .io_capacity =
            DOWNLOAD_IO_BUFFER_SIZE,
        .io_failed = false
    };

    ctx.io_buffer =
        malloc(
            ctx.io_capacity
        );

    if (!ctx.io_buffer) {
        curl_easy_cleanup(
            curl
        );

        fclose(
            file
        );

        remove(
            part_path
        );

        snprintf(
            error,
            error_size,
            "Could not allocate 1 MiB staging buffer"
        );

        return false;
    }

    if (
        !async_writer_start(
            &writer,
            file,
            error,
            error_size
        )
    ) {
        free(
            ctx.io_buffer
        );

        ctx.io_buffer = NULL;

        curl_easy_cleanup(
            curl
        );

        fclose(
            file
        );

        remove(
            part_path
        );

        return false;
    }

    curl_easy_setopt(
        curl,
        CURLOPT_URL,
        unlock->direct_url
    );
    curl_easy_setopt(
        curl,
        CURLOPT_HTTP_VERSION,
        CURL_HTTP_VERSION_1_1
    );

    curl_easy_setopt(
        curl,
        CURLOPT_FOLLOWLOCATION,
        1L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_MAXREDIRS,
        10L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_WRITEFUNCTION,
        file_write_callback
    );

    curl_easy_setopt(
        curl,
        CURLOPT_WRITEDATA,
        &ctx
    );
    
    curl_easy_setopt(
        curl,
        CURLOPT_BUFFERSIZE,
        CURL_RECV_BUFFER_SIZE
    );

    curl_easy_setopt(
        curl,
        CURLOPT_XFERINFOFUNCTION,
        progress_callback
    );

    curl_easy_setopt(
        curl,
        CURLOPT_XFERINFODATA,
        &ctx
    );

    curl_easy_setopt(
        curl,
        CURLOPT_NOPROGRESS,
        0L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_CONNECTTIMEOUT,
        30L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_TIMEOUT,
        0L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_LOW_SPEED_LIMIT,
        1024L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_LOW_SPEED_TIME,
        90L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_NOSIGNAL,
        1L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_SSL_VERIFYPEER,
        1L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_SSL_VERIFYHOST,
        2L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_FAILONERROR,
        1L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_USERAGENT,
        g_user_agent[0]
            ? g_user_agent
            : "SwitchDebridDownloader"
    );

    CURLcode rc =
        curl_easy_perform(
            curl
        );

    long http_status = 0;

    curl_easy_getinfo(
        curl,
        CURLINFO_RESPONSE_CODE,
        &http_status
    );

    bool io_ok =
        !ctx.io_failed;

    /*
     * Send the final partial 1 MiB block to the
     * asynchronous writer.
     */
    if (
        io_ok &&
        ctx.io_used > 0
    ) {
        size_t queued =
            async_writer_enqueue(
                &writer,
                (const char *)
                    ctx.io_buffer,
                ctx.io_used
            );

        if (
            queued !=
            ctx.io_used
        ) {
            io_ok = false;
        }

        ctx.io_used = 0;
    }

    bool writer_ok =
        async_writer_finish(
            &writer
        );

    io_ok =
        io_ok &&
        writer_ok;

    free(
        ctx.io_buffer
    );

    ctx.io_buffer = NULL;
    ctx.async_writer = NULL;

    curl_easy_cleanup(
        curl
    );

    if (
        fclose(
            file
        ) != 0
    ) {
        io_ok = false;
    }

    if (
        rc != CURLE_OK ||
        !io_ok ||
        (
            http_status != 200 &&
            http_status != 206
        )
    ) {
        snprintf(
            error,
            error_size,
            "Download failed: curl=%d HTTP=%ld",
            (int)rc,
            http_status
        );

        return false;
    }

    if (
        rename(
            part_path,
            final_path
        ) != 0
    ) {
        snprintf(
            error,
            error_size,
            "Could not finalize downloaded file"
        );

        return false;
    }

    if (
        !archive_extract_if_needed(
            final_path,
            error,
            error_size
        )
    ) {
        return false;
    }

    return true;
}


static bool download_file_segmented(
    int worker_index,
    const UnlockResult *unlock,
    const char *part_path,
    const char *final_path,
    char *error,
    size_t error_size
)
{
    if (
        unlock->filesize <
        DOWNLOAD_SEGMENTS
    ) {
        snprintf(
            error,
            error_size,
            "File size unavailable for segmented download"
        );

        return false;
    }

    if (
        !server_supports_byte_ranges(
            unlock->direct_url
        )
    ) {
        snprintf(
            error,
            error_size,
            "Server does not support byte ranges"
        );

        return false;
    }

    remove(
        part_path
    );

    char segment_paths[
        DOWNLOAD_SEGMENTS
    ][2144];

    memset(
        segment_paths,
        0,
        sizeof(segment_paths)
    );

    FILE *files[
        DOWNLOAD_SEGMENTS
    ] = {0};

    CURL *easy[
        DOWNLOAD_SEGMENTS
    ] = {0};

    CURLcode results[
        DOWNLOAD_SEGMENTS
    ];

    long http_status[
        DOWNLOAD_SEGMENTS
    ] = {0};

    unsigned long long expected[
        DOWNLOAD_SEGMENTS
    ] = {0};

    char ranges[
        DOWNLOAD_SEGMENTS
    ][64];

    SegmentDownloadContext contexts[
        DOWNLOAD_SEGMENTS
    ];

    memset(
        contexts,
        0,
        sizeof(contexts)
    );

    for (
        int i = 0;
        i < DOWNLOAD_SEGMENTS;
        i++
    ) {
        results[i] =
            CURLE_FAILED_INIT;
    }

    SegmentedDownloadState state;

    memset(
        &state,
        0,
        sizeof(state)
    );

    state.worker_index =
        worker_index;

    state.total =
        unlock->filesize;

    CURLM *multi =
        curl_multi_init();

    if (!multi) {
        snprintf(
            error,
            error_size,
            "curl_multi_init failed"
        );

        return false;
    }
    /*
     * Real 3-stream mode:
     * allow three independent connections.
     */
    curl_multi_setopt(
        multi,
        CURLMOPT_MAX_HOST_CONNECTIONS,
        3L
    );

    curl_multi_setopt(
        multi,
        CURLMOPT_MAX_TOTAL_CONNECTIONS,
        3L
    );


    bool setup_ok = true;

    const unsigned long long base =
        unlock->filesize /
        DOWNLOAD_SEGMENTS;

    for (
        int i = 0;
        i < DOWNLOAD_SEGMENTS;
        i++
    ) {
        unsigned long long start =
            (unsigned long long)i *
            base;

        unsigned long long end =
            i == DOWNLOAD_SEGMENTS - 1
                ? unlock->filesize - 1
                : start + base - 1;

        expected[i] =
            end - start + 1;

        snprintf(
            segment_paths[i],
            sizeof(segment_paths[i]),
            "%s.seg%d",
            part_path,
            i
        );

        remove(
            segment_paths[i]
        );

        files[i] =
            fopen(
                segment_paths[i],
                "wb"
            );

        if (!files[i]) {
            setup_ok = false;
            break;
        }

        /*
         * 8 MiB buffering per segment.
         *
         * Four segments = about 32 MiB of file buffering.
         */
        if (
            setvbuf(
                files[i],
                NULL,
                _IONBF,
            0
            ) != 0
        ) {
            setup_ok = false;
            break;
        }

        snprintf(
            ranges[i],
            sizeof(ranges[i]),
            "%llu-%llu",
            start,
            end
        );

        contexts[i].file =
            files[i];

        contexts[i].state =
            &state;

        contexts[i].segment_index =
            i;

        contexts[i].io_capacity =
            DOWNLOAD_IO_BUFFER_SIZE;

        contexts[i].io_used = 0;
        contexts[i].io_failed = false;

        contexts[i].io_buffer =
            malloc(
                contexts[i].io_capacity
            );

        if (!contexts[i].io_buffer) {
            setup_ok = false;
            break;
        }

        easy[i] =
            curl_easy_init();

        if (!easy[i]) {
            setup_ok = false;
            break;
        }

        curl_easy_setopt(
            easy[i],
            CURLOPT_URL,
            unlock->direct_url
        );

        curl_easy_setopt(
            easy[i],
            CURLOPT_HTTP_VERSION,
            CURL_HTTP_VERSION_1_1
        );


        curl_easy_setopt(
            easy[i],
            CURLOPT_RANGE,
            ranges[i]
        );

        /*
         * Match the successful parallel benchmark:
         * one independent TCP connection per range.
         */
        curl_easy_setopt(
            easy[i],
            CURLOPT_FRESH_CONNECT,
            1L
        );

        curl_easy_setopt(
            easy[i],
            CURLOPT_FORBID_REUSE,
            1L
        );

        curl_easy_setopt(
            easy[i],
            CURLOPT_FOLLOWLOCATION,
            1L
        );

        curl_easy_setopt(
            easy[i],
            CURLOPT_MAXREDIRS,
            10L
        );

        curl_easy_setopt(
            easy[i],
            CURLOPT_WRITEFUNCTION,
            segment_file_write_callback
        );

        curl_easy_setopt(
            easy[i],
            CURLOPT_WRITEDATA,
            &contexts[i]
        );

        curl_easy_setopt(
            easy[i],
            CURLOPT_BUFFERSIZE,
            CURL_RECV_BUFFER_SIZE
        );

        curl_easy_setopt(
            easy[i],
            CURLOPT_XFERINFOFUNCTION,
            segment_progress_callback
        );

        curl_easy_setopt(
            easy[i],
            CURLOPT_XFERINFODATA,
            &contexts[i]
        );

        curl_easy_setopt(
            easy[i],
            CURLOPT_NOPROGRESS,
            0L
        );

        curl_easy_setopt(
            easy[i],
            CURLOPT_CONNECTTIMEOUT,
            30L
        );

        curl_easy_setopt(
            easy[i],
            CURLOPT_TIMEOUT,
            0L
        );

        curl_easy_setopt(
            easy[i],
            CURLOPT_LOW_SPEED_LIMIT,
            1024L
        );

        curl_easy_setopt(
            easy[i],
            CURLOPT_LOW_SPEED_TIME,
            90L
        );

        curl_easy_setopt(
            easy[i],
            CURLOPT_NOSIGNAL,
            1L
        );

        curl_easy_setopt(
            easy[i],
            CURLOPT_SSL_VERIFYPEER,
            1L
        );

        curl_easy_setopt(
            easy[i],
            CURLOPT_SSL_VERIFYHOST,
            2L
        );

        curl_easy_setopt(
            easy[i],
            CURLOPT_FAILONERROR,
            1L
        );

        /*
         * The speed tests showed four connections are stable,
         * while attempts beyond that hit the Switch-side limit.
         * Force one independent TCP connection per segment.
         */

        curl_easy_setopt(
            easy[i],
            CURLOPT_USERAGENT,
            g_user_agent[0]
                ? g_user_agent
                : "SwitchDebridDownloader"
        );

        CURLMcode add_rc =
            curl_multi_add_handle(
                multi,
                easy[i]
            );

        if (add_rc != CURLM_OK) {
            setup_ok = false;
            break;
        }
    }

    CURLMcode mrc =
        CURLM_OK;

    if (setup_ok) {
        int running = 0;

        mrc =
            curl_multi_perform(
                multi,
                &running
            );

        while (
            mrc == CURLM_OK &&
            running > 0
        ) {
            int numfds = 0;

            mrc =
                curl_multi_wait(
                    multi,
                    NULL,
                    0,
                    1000,
                    &numfds
                );

            if (mrc != CURLM_OK)
                break;

            mrc =
                curl_multi_perform(
                    multi,
                    &running
                );
        }
    }

    int messages_left = 0;
    CURLMsg *message = NULL;

    while (
        (
            message =
                curl_multi_info_read(
                    multi,
                    &messages_left
                )
        ) != NULL
    ) {
        if (
            message->msg !=
            CURLMSG_DONE
        ) {
            continue;
        }

        for (
            int i = 0;
            i < DOWNLOAD_SEGMENTS;
            i++
        ) {
            if (
                easy[i] ==
                message->easy_handle
            ) {
                results[i] =
                    message->data.result;

                break;
            }
        }
    }

    bool success =
        setup_ok &&
        mrc == CURLM_OK;

    for (
        int i = 0;
        i < DOWNLOAD_SEGMENTS;
        i++
    ) {
        if (easy[i]) {
            curl_easy_getinfo(
                easy[i],
                CURLINFO_RESPONSE_CODE,
                &http_status[i]
            );
        }

        if (contexts[i].io_buffer) {
            if (
                success &&
                (
                    contexts[i].io_failed ||
                    !buffered_file_flush(
                        contexts[i].file,
                        contexts[i].io_buffer,
                        &contexts[i].io_used,
                        &contexts[i].io_failed
                    )
                )
            ) {
                success = false;
            }

            free(
                contexts[i].io_buffer
            );

            contexts[i].io_buffer = NULL;
        }

        if (files[i]) {
            if (
                fclose(
                    files[i]
                ) != 0
            ) {
                success = false;
            }

            files[i] = NULL;
        }

        if (easy[i]) {
            curl_multi_remove_handle(
                multi,
                easy[i]
            );

            curl_easy_cleanup(
                easy[i]
            );

            easy[i] = NULL;
        }
    }

    curl_multi_cleanup(
        multi
    );

    for (
        int i = 0;
        i < DOWNLOAD_SEGMENTS;
        i++
    ) {
        struct stat st;

        if (
            results[i] != CURLE_OK ||
            http_status[i] != 206 ||
            stat(
                segment_paths[i],
                &st
            ) != 0 ||
            (unsigned long long)st.st_size !=
                expected[i]
        ) {
            success = false;

            if (!error[0]) {
                snprintf(
                    error,
                    error_size,
                    "Segment %d failed: curl=%d HTTP=%ld",
                    i + 1,
                    (int)results[i],
                    http_status[i]
                );
            }
        }
    }

    if (
        success &&
        !combine_segment_files(
            segment_paths,
            part_path,
            error,
            error_size
        )
    ) {
        success = false;
    }

    remove_segment_files(
        segment_paths
    );

    if (!success) {
        remove(
            part_path
        );

        if (!error[0]) {
            snprintf(
                error,
                error_size,
                "Segmented download failed"
            );
        }

        return false;
    }

    if (
        rename(
            part_path,
            final_path
        ) != 0
    ) {
        remove(
            part_path
        );

        snprintf(
            error,
            error_size,
            "Could not finalize downloaded file"
        );

        return false;
    }

    if (
        !archive_extract_if_needed(
            final_path,
            error,
            error_size
        )
    ) {
        return false;
    }

    return true;
}


static bool download_file(
    int worker_index,
    const UnlockResult *unlock,
    char *error,
    size_t error_size
)
{
    char filename[1024];

    snprintf(
        filename,
        sizeof(filename),
        "%s",
        unlock->filename[0]
            ? unlock->filename
            : "download.bin"
    );

    sanitize_filename(
        filename
    );

    char final_path[2048];
    char part_path[2080];

    choose_output_path(
        filename,
        final_path,
        sizeof(final_path),
        part_path,
        sizeof(part_path)
    );

    /*
     * The Switch tests showed four simultaneous HTTP/1.1
     * connections are stable and materially faster than one.
     * Try the four-range path first. If the host does not honor
     * ranges, the file size is unavailable, or any segment fails,
     * clean up and fall back to the proven single-stream path.
     */
    char segmented_error[512] = {0};

    if (
        download_file_segmented(
            worker_index,
            unlock,
            part_path,
            final_path,
            segmented_error,
            sizeof(segmented_error)
        )
    ) {
        return true;
    }

    /* Reset progress before the fallback starts from byte zero. */
    mutexLock(
        &g_mutex
    );

    g_worker_progress[
        worker_index
    ].downloaded = 0;

    g_worker_progress[
        worker_index
    ].total =
        unlock->filesize;

    g_worker_progress[
        worker_index
    ].bytes_per_second = 0;

    g_worker_progress[
        worker_index
    ].last_downloaded = 0;

    g_worker_progress[
        worker_index
    ].last_time.tv_sec = 0;

    g_worker_progress[
        worker_index
    ].last_time.tv_nsec = 0;

    mutexUnlock(
        &g_mutex
    );

    bool ok =
        download_file_single(
            worker_index,
            unlock,
            part_path,
            final_path,
            error,
            error_size
        );

    if (
        !ok &&
        segmented_error[0] &&
        error[0]
    ) {
        char single_error[512];

        snprintf(
            single_error,
            sizeof(single_error),
            "%s",
            error
        );

        snprintf(
            error,
            error_size,
            "3-stream: %.180s; fallback: %.180s",
            segmented_error,
            single_error
        );
    }

    return ok;
}


