void downloader_get_curl_runtime_info(
    char *version,
    size_t version_size,
    char *ssl,
    size_t ssl_size,
    bool *http2_supported
)
{
    if (
        version &&
        version_size > 0
    ) {
        version[0] = '\0';
    }

    if (
        ssl &&
        ssl_size > 0
    ) {
        ssl[0] = '\0';
    }

    if (http2_supported)
        *http2_supported = false;

    const curl_version_info_data *info =
        curl_version_info(
            CURLVERSION_NOW
        );

    if (!info)
        return;

    if (
        version &&
        version_size > 0
    ) {
        snprintf(
            version,
            version_size,
            "%s",
            info->version
                ? info->version
                : "unknown"
        );
    }

    if (
        ssl &&
        ssl_size > 0
    ) {
        snprintf(
            ssl,
            ssl_size,
            "%s",
            info->ssl_version
                ? info->ssl_version
                : "none/unknown"
        );
    }

    if (http2_supported) {
        *http2_supported =
            (
                info->features &
                CURL_VERSION_HTTP2
            ) != 0;
    }
}


