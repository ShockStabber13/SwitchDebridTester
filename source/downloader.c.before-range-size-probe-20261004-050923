static size_t api_write(
    char *ptr,
    size_t size,
    size_t nmemb,
    void *userdata
)
{
    ApiBuffer *buffer =
        (ApiBuffer *)userdata;

    size_t amount =
        size * nmemb;

    if (
        buffer->size +
        amount +
        1 >
        buffer->capacity
    ) {
        buffer->overflow =
            true;

        return 0;
    }

    memcpy(
        buffer->data +
        buffer->size,
        ptr,
        amount
    );

    buffer->size += amount;

    buffer->data[
        buffer->size
    ] = '\0';

    return amount;
}


static void configure_common_curl(
    CURL *curl
)
{
    curl_easy_setopt(
        curl,
        CURLOPT_CONNECTTIMEOUT,
        20L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_TIMEOUT,
        60L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_NOSIGNAL,
        1L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_SSL_VERIFYPEER,
        1L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_SSL_VERIFYHOST,
        2L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_USERAGENT,
        g_user_agent[0]
            ? g_user_agent
            : "SwitchDebridDownloader"
    );
}


static struct curl_slist *
make_auth_headers(void)
{
    char auth[1200];

    snprintf(
        auth,
        sizeof(auth),
        "Authorization: Bearer %s",
        g_token
    );

    struct curl_slist *headers =
        NULL;

    headers =
        curl_slist_append(
            headers,
            auth
        );

    headers =
        curl_slist_append(
            headers,
            "Content-Type: application/x-www-form-urlencoded"
        );

    return headers;
}


static bool form_encode(
    const char *input,
    char **output
)
{
    size_t input_len =
        strlen(input);

    size_t capacity =
        input_len * 3 +
        1;

    char *encoded =
        malloc(capacity);

    if (!encoded)
        return false;

    static const char hex[] =
        "0123456789ABCDEF";

    size_t out = 0;

    for (
        size_t i = 0;
        i < input_len;
        i++
    ) {
        unsigned char c =
            (unsigned char)input[i];

        if (
            isalnum(c) ||
            c == '-' ||
            c == '_' ||
            c == '.' ||
            c == '~'
        ) {
            encoded[out++] =
                (char)c;
        }
        else {
            encoded[out++] = '%';
            encoded[out++] =
                hex[
                    (c >> 4) &
                    0xF
                ];

            encoded[out++] =
                hex[
                    c & 0xF
                ];
        }
    }

    encoded[out] = '\0';

    *output = encoded;

    return true;
}


static bool api_post(
    const char *endpoint,
    const char *post_data,
    char *response,
    size_t response_size,
    long *http_status
)
{
    CURL *curl =
        curl_easy_init();

    if (!curl)
        return false;

    ApiBuffer buffer = {
        .data = response,
        .size = 0,
        .capacity = response_size,
        .overflow = false
    };

    response[0] = '\0';

    struct curl_slist *headers =
        make_auth_headers();

    curl_easy_setopt(
        curl,
        CURLOPT_URL,
        endpoint
    );

    curl_easy_setopt(
        curl,
        CURLOPT_HTTPHEADER,
        headers
    );

    curl_easy_setopt(
        curl,
        CURLOPT_POST,
        1L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_POSTFIELDS,
        post_data
    );

    curl_easy_setopt(
        curl,
        CURLOPT_WRITEFUNCTION,
        api_write
    );

    curl_easy_setopt(
        curl,
        CURLOPT_WRITEDATA,
        &buffer
    );

    configure_common_curl(
        curl
    );

    CURLcode rc =
        curl_easy_perform(
            curl
        );

    *http_status = 0;

    curl_easy_getinfo(
        curl,
        CURLINFO_RESPONSE_CODE,
        http_status
    );

    curl_easy_cleanup(
        curl
    );

    if (headers)
        curl_slist_free_all(
            headers
        );

    return
        rc == CURLE_OK &&
        !buffer.overflow;
}


/* ========================================================= */
/* AllDebrid unlock + delayed flow                           */
/* ========================================================= */

static bool poll_delayed(
    unsigned long long delayed_id,
    char *direct_url,
    size_t direct_url_size,
    char *error,
    size_t error_size
)
{
    char *response =
        malloc(
            API_BODY_MAX
        );

    if (!response) {
        snprintf(
            error,
            error_size,
            "Out of memory"
        );

        return false;
    }

    for (
        int attempt = 0;
        attempt < 60 &&
        g_running;
        attempt++
    ) {
        /*
         * AllDebrid requests at least five seconds
         * between delayed-link status checks.
         */
        svcSleepThread(
            5LL *
            1000LL *
            1000LL *
            1000LL
        );

        char post_data[128];

        snprintf(
            post_data,
            sizeof(post_data),
            "id=%llu",
            delayed_id
        );

        long status = 0;

        bool request_ok =
            api_post(
                "https://api.alldebrid.com/v4/link/delayed",
                post_data,
                response,
                API_BODY_MAX,
                &status
            );

        if (
            !request_ok ||
            status != 200 ||
            !api_success(response)
        ) {
            snprintf(
                error,
                error_size,
                "Delayed-link API error"
            );

            free(response);
            return false;
        }

        const char *data =
            strstr(
                response,
                "\"data\""
            );

        if (!data)
            data = response;

        unsigned long long
            delayed_status = 0;

        if (
            !json_u64(
                data,
                "status",
                &delayed_status
            )
        ) {
            snprintf(
                error,
                error_size,
                "Invalid delayed-link response"
            );

            free(response);
            return false;
        }

        if (
            delayed_status == 2
        ) {
            bool found =
                json_string(
                    data,
                    "link",
                    direct_url,
                    direct_url_size
                );

            free(response);

            if (
                !found ||
                !direct_url[0]
            ) {
                snprintf(
                    error,
                    error_size,
                    "Delayed link ready but URL missing"
                );

                return false;
            }

            return true;
        }

        if (
            delayed_status == 3
        ) {
            snprintf(
                error,
                error_size,
                "AllDebrid could not generate link"
            );

            free(response);
            return false;
        }
    }

    free(response);

    snprintf(
        error,
        error_size,
        "Delayed-link timeout"
    );

    return false;
}


static bool unlock_link(
    const char *source_url,
    UnlockResult *result
)
{
    memset(
        result,
        0,
        sizeof(*result)
    );

    char *encoded = NULL;

    if (
        !form_encode(
            source_url,
            &encoded
        )
    ) {
        snprintf(
            result->error,
            sizeof(result->error),
            "Could not encode source URL"
        );

        return false;
    }

    size_t post_size =
        strlen(encoded) +
        16;

    char *post_data =
        malloc(
            post_size
        );

    if (!post_data) {
        free(encoded);

        snprintf(
            result->error,
            sizeof(result->error),
            "Out of memory"
        );

        return false;
    }

    snprintf(
        post_data,
        post_size,
        "link=%s",
        encoded
    );

    free(encoded);

    char *response =
        malloc(
            API_BODY_MAX
        );

    if (!response) {
        free(post_data);

        snprintf(
            result->error,
            sizeof(result->error),
            "Out of memory"
        );

        return false;
    }

    long status = 0;

    bool request_ok =
        api_post(
            "https://api.alldebrid.com/v4/link/unlock",
            post_data,
            response,
            API_BODY_MAX,
            &status
        );

    free(post_data);

    if (
        !request_ok ||
        status != 200 ||
        !api_success(response)
    ) {
        char code[128] = {0};
        char message[256] = {0};

        json_string(
            response,
            "code",
            code,
            sizeof(code)
        );

        json_string(
            response,
            "message",
            message,
            sizeof(message)
        );

        snprintf(
            result->error,
            sizeof(result->error),
            "%s%s%s",
            code[0]
                ? code
                : "Unlock failed",
            message[0]
                ? ": "
                : "",
            message
        );

        free(response);

        return false;
    }

    const char *data =
        strstr(
            response,
            "\"data\""
        );

    if (!data)
        data = response;

    json_string(
        data,
        "filename",
        result->filename,
        sizeof(result->filename)
    );

    json_u64(
        data,
        "filesize",
        &result->filesize
    );

    if (
        json_string(
            data,
            "link",
            result->direct_url,
            sizeof(result->direct_url)
        ) &&
        result->direct_url[0]
    ) {
        result->success = true;

        free(response);

        return true;
    }

    json_u64(
        data,
        "delayed",
        &result->delayed
    );

    free(response);

    if (
        result->delayed > 0
    ) {
        if (
            poll_delayed(
                result->delayed,
                result->direct_url,
                sizeof(result->direct_url),
                result->error,
                sizeof(result->error)
            )
        ) {
            result->success = true;
            return true;
        }

        return false;
    }

    snprintf(
        result->error,
        sizeof(result->error),
        "No download URL returned"
    );

    return false;
}



/* ========================================================= */
/* Direct URL preparation                                    */
/* ========================================================= */

typedef struct {
    char filename[1024];
    unsigned long long content_length;
    unsigned long long content_range_total;
} DirectProbeInfo;


typedef struct {
    size_t received;
    size_t limit;
} DirectProbeBody;


static int hex_value(
    char c
)
{
    if (
        c >= '0' &&
        c <= '9'
    )
        return c - '0';

    if (
        c >= 'a' &&
        c <= 'f'
    )
        return c - 'a' + 10;

    if (
        c >= 'A' &&
        c <= 'F'
    )
        return c - 'A' + 10;

    return -1;
}


static void percent_decode_in_place(
    char *text
)
{
    char *src = text;
    char *dst = text;

    while (*src) {
        if (
            src[0] == '%' &&
            src[1] &&
            src[2]
        ) {
            int hi =
                hex_value(
                    src[1]
                );

            int lo =
                hex_value(
                    src[2]
                );

            if (
                hi >= 0 &&
                lo >= 0
            ) {
                *dst++ =
                    (char)(
                        (hi << 4) |
                        lo
                    );

                src += 3;
                continue;
            }
        }

        *dst++ = *src++;
    }

    *dst = '\0';
}


static const char *case_find(
    const char *haystack,
    const char *needle
)
{
    size_t needle_len =
        strlen(needle);

    if (!needle_len)
        return haystack;

    for (
        const char *p = haystack;
        *p;
        p++
    ) {
        if (
            strncasecmp(
                p,
                needle,
                needle_len
            ) == 0
        ) {
            return p;
        }
    }

    return NULL;
}


static void direct_copy_filename(
    DirectProbeInfo *info,
    const char *start,
    const char *end
)
{
    if (
        !info ||
        !start ||
        !end ||
        end <= start
    ) {
        return;
    }

    while (
        start < end &&
        (
            *start == ' ' ||
            *start == '\t' ||
            *start == '"'
        )
    ) {
        start++;
    }

    while (
        end > start &&
        (
            end[-1] == ' ' ||
            end[-1] == '\t' ||
            end[-1] == '"' ||
            end[-1] == '\r' ||
            end[-1] == '\n'
        )
    ) {
        end--;
    }

    size_t len =
        (size_t)(end - start);

    if (
        !len ||
        len >= sizeof(info->filename)
    ) {
        return;
    }

    memcpy(
        info->filename,
        start,
        len
    );

    info->filename[len] =
        '\0';

    percent_decode_in_place(
        info->filename
    );
}


static size_t direct_probe_header(
    char *buffer,
    size_t size,
    size_t nmemb,
    void *userdata
)
{
    DirectProbeInfo *info =
        (DirectProbeInfo *)userdata;

    size_t bytes =
        size * nmemb;

    if (
        !info ||
        bytes == 0
    ) {
        return bytes;
    }

    char line[4096];

    size_t copy =
        bytes < sizeof(line) - 1
            ? bytes
            : sizeof(line) - 1;

    memcpy(
        line,
        buffer,
        copy
    );

    line[copy] = '\0';

    /* A redirect can produce several header blocks. Keep only
     * metadata from the most recent HTTP response. */
    if (
        strncasecmp(
            line,
            "HTTP/",
            5
        ) == 0
    ) {
        info->filename[0] = '\0';
        info->content_length = 0;
        info->content_range_total = 0;
        return bytes;
    }

    if (
        strncasecmp(
            line,
            "Content-Disposition:",
            20
        ) == 0
    ) {
        const char *p =
            case_find(
                line,
                "filename*="
            );

        if (p) {
            p += 10;

            const char *value = p;

            const char *ticks =
                strstr(
                    value,
                    "''"
                );

            if (ticks)
                value =
                    ticks + 2;

            const char *end = value;

            while (
                *end &&
                *end != ';' &&
                *end != '\r' &&
                *end != '\n'
            ) {
                end++;
            }

            direct_copy_filename(
                info,
                value,
                end
            );
        }

        if (!info->filename[0]) {
            p =
                case_find(
                    line,
                    "filename="
                );

            if (p) {
                p += 9;

                const char *end = p;

                if (*p == '"') {
                    p++;
                    end =
                        strchr(
                            p,
                            '"'
                        );

                    if (!end)
                        end =
                            p + strlen(p);
                }
                else {
                    while (
                        *end &&
                        *end != ';' &&
                        *end != '\r' &&
                        *end != '\n'
                    ) {
                        end++;
                    }
                }

                direct_copy_filename(
                    info,
                    p,
                    end
                );
            }
        }
    }
    else if (
        strncasecmp(
            line,
            "Content-Range:",
            14
        ) == 0
    ) {
        const char *slash =
            strrchr(
                line,
                '/'
            );

        if (
            slash &&
            slash[1] >= '0' &&
            slash[1] <= '9'
        ) {
            info->content_range_total =
                strtoull(
                    slash + 1,
                    NULL,
                    10
                );
        }
    }
    else if (
        strncasecmp(
            line,
            "Content-Length:",
            15
        ) == 0
    ) {
        const char *p =
            line + 15;

        while (
            *p == ' ' ||
            *p == '\t'
        ) {
            p++;
        }

        unsigned long long value =
            strtoull(
                p,
                NULL,
                10
            );

        if (value > 0)
            info->content_length =
                value;
    }

    return bytes;
}


static size_t direct_probe_write(
    char *ptr,
    size_t size,
    size_t nmemb,
    void *userdata
)
{
    (void)ptr;

    DirectProbeBody *body =
        (DirectProbeBody *)userdata;

    size_t bytes =
        size * nmemb;

    if (!body)
        return 0;

    size_t remaining =
        body->received <
        body->limit
            ? body->limit -
              body->received
            : 0;

    if (!remaining)
        return 0;

    size_t accepted =
        bytes < remaining
            ? bytes
            : remaining;

    body->received +=
        accepted;

    return accepted;
}


static bool direct_filename_from_url(
    const char *url,
    char *filename,
    size_t filename_size
)
{
    if (
        !url ||
        !url[0] ||
        !filename ||
        filename_size == 0
    ) {
        return false;
    }

    const char *end =
        url + strlen(url);

    const char *query =
        strchr(
            url,
            '?'
        );

    if (
        query &&
        query < end
    )
        end = query;

    const char *fragment =
        strchr(
            url,
            '#'
        );

    if (
        fragment &&
        fragment < end
    )
        end = fragment;

    const char *start = end;

    while (
        start > url &&
        start[-1] != '/'
    ) {
        start--;
    }

    if (
        start >= end ||
        *start == '\0'
    ) {
        return false;
    }

    size_t len =
        (size_t)(end - start);

    if (len >= filename_size)
        len =
            filename_size - 1;

    memcpy(
        filename,
        start,
        len
    );

    filename[len] =
        '\0';

    percent_decode_in_place(
        filename
    );

    return
        filename[0] != '\0';
}


static void make_unconfirmed_name(
    int worker_index,
    char *filename,
    size_t filename_size
)
{
    struct timespec now;

    clock_gettime(
        CLOCK_MONOTONIC,
        &now
    );

    unsigned long long number =
        (
            (unsigned long long)now.tv_nsec +
            (unsigned long long)now.tv_sec *
                997ULL +
            (unsigned long long)
                (worker_index + 1) *
                7919ULL
        ) %
        1000000ULL;

    snprintf(
        filename,
        filename_size,
        "Unconfirmed %06llu.crdownload",
        number
    );
}


static void direct_probe_request(
    const char *url,
    bool head_only,
    DirectProbeInfo *info,
    char *effective_url,
    size_t effective_url_size
)
{
    CURL *curl =
        curl_easy_init();

    if (!curl)
        return;

    DirectProbeBody body = {
        .received = 0,
        .limit = 1
    };

    curl_easy_setopt(
        curl,
        CURLOPT_URL,
        url
    );

    curl_easy_setopt(
        curl,
        CURLOPT_FOLLOWLOCATION,
        1L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_MAXREDIRS,
        10L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_HEADERFUNCTION,
        direct_probe_header
    );

    curl_easy_setopt(
        curl,
        CURLOPT_HEADERDATA,
        info
    );

    curl_easy_setopt(
        curl,
        CURLOPT_CONNECTTIMEOUT,
        20L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_TIMEOUT,
        30L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_NOSIGNAL,
        1L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_SSL_VERIFYPEER,
        1L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_SSL_VERIFYHOST,
        2L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_USERAGENT,
        g_user_agent[0]
            ? g_user_agent
            : "SwitchDebridDownloader"
    );

    if (head_only) {
        curl_easy_setopt(
            curl,
            CURLOPT_NOBODY,
            1L
        );
    }
    else {
        curl_easy_setopt(
            curl,
            CURLOPT_RANGE,
            "0-0"
        );

        curl_easy_setopt(
            curl,
            CURLOPT_WRITEFUNCTION,
            direct_probe_write
        );

        curl_easy_setopt(
            curl,
            CURLOPT_WRITEDATA,
            &body
        );
    }

    (void)curl_easy_perform(
        curl
    );

    const char *effective =
        NULL;

    curl_easy_getinfo(
        curl,
        CURLINFO_EFFECTIVE_URL,
        &effective
    );

    if (
        effective &&
        effective[0] &&
        effective_url &&
        effective_url_size > 0
    ) {
        snprintf(
            effective_url,
            effective_url_size,
            "%s",
            effective
        );
    }

    curl_easy_cleanup(
        curl
    );
}


static bool prepare_direct_link(
    int worker_index,
    const char *source_url,
    UnlockResult *result
)
{
    memset(
        result,
        0,
        sizeof(*result)
    );

    if (
        !source_url ||
        (
            strncasecmp(
                source_url,
                "http://",
                7
            ) != 0 &&
            strncasecmp(
                source_url,
                "https://",
                8
            ) != 0
        )
    ) {
        snprintf(
            result->error,
            sizeof(result->error),
            "Direct mode requires an http:// or https:// URL"
        );

        return false;
    }

    snprintf(
        result->direct_url,
        sizeof(result->direct_url),
        "%s",
        source_url
    );

    DirectProbeInfo info;

    memset(
        &info,
        0,
        sizeof(info)
    );

    char effective_url[8192] = {0};

    direct_probe_request(
        source_url,
        true,
        &info,
        effective_url,
        sizeof(effective_url)
    );

    if (
        !info.filename[0] ||
        (
            info.content_length == 0 &&
            info.content_range_total == 0
        )
    ) {
        direct_probe_request(
            source_url,
            false,
            &info,
            effective_url,
            sizeof(effective_url)
        );
    }

    if (info.filename[0]) {
        snprintf(
            result->filename,
            sizeof(result->filename),
            "%s",
            info.filename
        );
    }
    else if (
        effective_url[0] &&
        direct_filename_from_url(
            effective_url,
            result->filename,
            sizeof(result->filename)
        )
    ) {
    }
    else if (
        direct_filename_from_url(
            source_url,
            result->filename,
            sizeof(result->filename)
        )
    ) {
    }
    else {
        make_unconfirmed_name(
            worker_index,
            result->filename,
            sizeof(result->filename)
        );
    }

    result->filesize =
        info.content_range_total
            ? info.content_range_total
            : info.content_length;

    result->success = true;

    return true;
}


