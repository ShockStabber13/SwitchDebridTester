static char *duplicate_string(
    const char *text
)
{
    size_t len =
        strlen(text);

    char *copy =
        malloc(
            len + 1
        );

    if (!copy)
        return NULL;

    memcpy(
        copy,
        text,
        len + 1
    );

    return copy;
}


static void append_log(
    const char *path,
    const char *url,
    const char *message
)
{
    FILE *f =
        fopen(
            path,
            "a"
        );

    if (!f)
        return;

    fprintf(
        f,
        "%s\t%s\n",
        message ? message : "",
        url ? url : ""
    );

    fclose(f);
}


static const char *skip_space(
    const char *p
)
{
    while (
        *p == ' ' ||
        *p == '\t' ||
        *p == '\r' ||
        *p == '\n'
    ) {
        p++;
    }

    return p;
}


/* ========================================================= */
/* Small JSON parser                                         */
/* ========================================================= */

static bool json_string(
    const char *json,
    const char *key,
    char *output,
    size_t output_size
)
{
    char needle[128];

    snprintf(
        needle,
        sizeof(needle),
        "\"%s\"",
        key
    );

    const char *p =
        strstr(
            json,
            needle
        );

    if (!p)
        return false;

    p += strlen(needle);
    p = skip_space(p);

    if (*p != ':')
        return false;

    p++;
    p = skip_space(p);

    if (*p != '"')
        return false;

    p++;

    size_t out = 0;

    while (
        *p &&
        *p != '"' &&
        out + 1 < output_size
    ) {
        if (*p == '\\') {
            p++;

            if (!*p)
                break;

            switch (*p) {
                case '"':
                    output[out++] = '"';
                    break;

                case '\\':
                    output[out++] = '\\';
                    break;

                case '/':
                    output[out++] = '/';
                    break;

                case 'n':
                    output[out++] = '\n';
                    break;

                case 'r':
                    output[out++] = '\r';
                    break;

                case 't':
                    output[out++] = '\t';
                    break;

                default:
                    output[out++] = *p;
                    break;
            }

            p++;
            continue;
        }

        output[out++] =
            *p++;
    }

    output[out] = '\0';

    return true;
}


static bool json_u64(
    const char *json,
    const char *key,
    unsigned long long *value
)
{
    char needle[128];

    snprintf(
        needle,
        sizeof(needle),
        "\"%s\"",
        key
    );

    const char *p =
        strstr(
            json,
            needle
        );

    if (!p)
        return false;

    p += strlen(needle);
    p = skip_space(p);

    if (*p != ':')
        return false;

    p++;
    p = skip_space(p);

    if (
        *p < '0' ||
        *p > '9'
    ) {
        return false;
    }

    *value =
        strtoull(
            p,
            NULL,
            10
        );

    return true;
}


static bool api_success(
    const char *json
)
{
    char status[32];

    if (
        !json_string(
            json,
            "status",
            status,
            sizeof(status)
        )
    ) {
        return false;
    }

    return
        strcmp(
            status,
            "success"
        ) == 0;
}


