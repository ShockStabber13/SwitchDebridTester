/* Worker                                                    */
/* ========================================================= */

static void worker_thread(
    void *arg
)
{
    int worker_index =
        (int)(intptr_t)arg;

    while (g_running) {
        char *job =
            pop_job();

        if (!job) {
            svcSleepThread(
                200LL *
                1000LL *
                1000LL
            );

            continue;
        }

        bool through_alldebrid =
            job[0] == 'A' &&
            job[1] == '\t';

        bool direct =
            job[0] == 'D' &&
            job[1] == '\t';

        char *source_url =
            (
                through_alldebrid ||
                direct
            )
                ? job + 2
                : job;

        mutexLock(
            &g_mutex
        );

        g_worker_progress[
            worker_index
        ].active = true;

        g_worker_progress[
            worker_index
        ].downloaded = 0;

        g_worker_progress[
            worker_index
        ].total = 0;

        snprintf(
            g_worker_progress[worker_index].filename,
            sizeof(g_worker_progress[worker_index].filename),
            "%s",
            through_alldebrid
                ? "Unlocking through AllDebrid..."
                : "Preparing direct URL..."
        );

        mutexUnlock(
            &g_mutex
        );

        UnlockResult unlock;

        bool success =
            through_alldebrid
                ? unlock_link(
                    source_url,
                    &unlock
                )
                : prepare_direct_link(
                    worker_index,
                    source_url,
                    &unlock
                );

        char error[512] = {0};

        if (success) {
            mutexLock(
                &g_mutex
            );

            snprintf(
                g_worker_progress[worker_index].filename,
                sizeof(g_worker_progress[worker_index].filename),
                "%s",
                unlock.filename[0]
                    ? unlock.filename
                    : "download.bin"
            );

            mutexUnlock(
                &g_mutex
            );

            success =
                download_file(
                    worker_index,
                    &unlock,
                    error,
                    sizeof(error)
                );
        }
        else {
            snprintf(
                error,
                sizeof(error),
                "%s",
                unlock.error[0]
                    ? unlock.error
                    : (
                        through_alldebrid
                            ? "Unlock failed"
                            : "Direct URL preparation failed"
                    )
            );
        }

        mutexLock(
            &g_mutex
        );

        g_worker_progress[
            worker_index
        ].active = false;

        g_worker_progress[
            worker_index
        ].downloaded = 0;

        g_worker_progress[
            worker_index
        ].total = 0;

        g_worker_progress[
            worker_index
        ].filename[0] = '\0';

        if (success) {
            g_completed++;
        }
        else {
            g_failed++;

            snprintf(
                g_last_error,
                sizeof(g_last_error),
                "%s",
                error[0]
                    ? error
                    : "Unknown download failure"
            );
        }

        mutexUnlock(
            &g_mutex
        );

        if (success) {
            append_log(
                COMPLETED_LOG,
                source_url,
                unlock.filename
            );
        }
        else {
            append_log(
                FAILED_LOG,
                source_url,
                error
            );
        }

        free(
            job
        );
    }
}



/* ========================================================= */
/* Speed diagnostics                                         */
/* ========================================================= */

typedef struct {
    unsigned long long bytes;
    unsigned long long limit;
} NetworkDiagContext;


static size_t network_diag_write(
    char *ptr,
    size_t size,
    size_t nmemb,
    void *userdata
)
{
    (void)ptr;

    NetworkDiagContext *ctx =
        (NetworkDiagContext *)userdata;

    size_t amount =
        size * nmemb;

    ctx->bytes +=
        (unsigned long long)amount;

    return amount;
}


static int network_diag_progress(
    void *userdata,
    curl_off_t dltotal,
    curl_off_t dlnow,
    curl_off_t ultotal,
    curl_off_t ulnow
)
{
    (void)dltotal;
    (void)ultotal;
    (void)ulnow;

    NetworkDiagContext *ctx =
        (NetworkDiagContext *)userdata;

    if (
        dlnow >= 0 &&
        (unsigned long long)dlnow >=
            ctx->limit
    ) {
        return 1;
    }

    return 0;
}


static double elapsed_seconds(
    const struct timespec *start,
    const struct timespec *end
)
{
    return
        (double)(
            end->tv_sec -
            start->tv_sec
        ) +
        (double)(
            end->tv_nsec -
            start->tv_nsec
        ) /
        1000000000.0;
}




typedef struct {
    CURL *easy;
    NetworkDiagContext progress;
    char url[256];
} RawParallelTest;


bool downloader_debug_raw_parallel_8(
    double *mb_per_second,
    unsigned long long *bytes_tested,
    char *error,
    size_t error_size
)
{
    if (mb_per_second)
        *mb_per_second = 0.0;

    if (bytes_tested)
        *bytes_tested = 0;

    enum {
        CONNECTIONS = 8
    };

    const unsigned long long per_connection =
        4ULL *
        1024ULL *
        1024ULL;

    RawParallelTest tests[CONNECTIONS];
    CURLcode results[CONNECTIONS];

    memset(
        tests,
        0,
        sizeof(tests)
    );

    for (
        int i = 0;
        i < CONNECTIONS;
        i++
    ) {
        results[i] = CURLE_OK;
    }

    CURLM *multi =
        curl_multi_init();

    if (!multi) {
        snprintf(
            error,
            error_size,
            "curl_multi_init failed."
        );

        return false;
    }

    bool setup_ok = true;

    for (
        int i = 0;
        i < CONNECTIONS;
        i++
    ) {
        /*
         * Separate query parameter prevents the test
         * connections from looking identical to caches.
         */
        snprintf(
            tests[i].url,
            sizeof(tests[i].url),
            "https://speed.cloudflare.com/"
            "__down?bytes=4194304&id=%d",
            i
        );

        tests[i].easy =
            curl_easy_init();

        if (!tests[i].easy) {
            setup_ok = false;
            break;
        }

        tests[i].progress.bytes = 0;
        tests[i].progress.limit =
            per_connection;

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_URL,
            tests[i].url
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_WRITEFUNCTION,
            network_diag_write
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_WRITEDATA,
            &tests[i].progress
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_FOLLOWLOCATION,
            1L
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_MAXREDIRS,
            5L
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_CONNECTTIMEOUT,
            20L
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_TIMEOUT,
            90L
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_NOSIGNAL,
            1L
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_SSL_VERIFYPEER,
            1L
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_SSL_VERIFYHOST,
            2L
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_HTTP_VERSION,
            CURL_HTTP_VERSION_1_1
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_FRESH_CONNECT,
            1L
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_FORBID_REUSE,
            1L
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_USERAGENT,
            "SwitchDebridDownloader"
        );

        if (
            curl_multi_add_handle(
                multi,
                tests[i].easy
            ) != CURLM_OK
        ) {
            setup_ok = false;
            break;
        }
    }

    if (!setup_ok) {
        for (
            int i = 0;
            i < CONNECTIONS;
            i++
        ) {
            if (tests[i].easy) {
                curl_multi_remove_handle(
                    multi,
                    tests[i].easy
                );

                curl_easy_cleanup(
                    tests[i].easy
                );
            }
        }

        curl_multi_cleanup(multi);

        snprintf(
            error,
            error_size,
            "Could not prepare raw 8-way test."
        );

        return false;
    }

    struct timespec start;
    struct timespec end;

    clock_gettime(
        CLOCK_MONOTONIC,
        &start
    );

    int running = 0;

    CURLMcode mrc =
        curl_multi_perform(
            multi,
            &running
        );

    while (
        mrc == CURLM_OK &&
        running > 0
    ) {
        int numfds = 0;

        mrc =
            curl_multi_wait(
                multi,
                NULL,
                0,
                1000,
                &numfds
            );

        if (mrc != CURLM_OK)
            break;

        mrc =
            curl_multi_perform(
                multi,
                &running
            );
    }

    clock_gettime(
        CLOCK_MONOTONIC,
        &end
    );

    int messages_left = 0;
    CURLMsg *msg = NULL;

    while (
        (
            msg =
                curl_multi_info_read(
                    multi,
                    &messages_left
                )
        ) != NULL
    ) {
        if (
            msg->msg !=
            CURLMSG_DONE
        ) {
            continue;
        }

        for (
            int i = 0;
            i < CONNECTIONS;
            i++
        ) {
            if (
                tests[i].easy ==
                msg->easy_handle
            ) {
                results[i] =
                    msg->data.result;

                break;
            }
        }
    }

    bool success =
        mrc == CURLM_OK;

    unsigned long long total_bytes = 0;

    for (
        int i = 0;
        i < CONNECTIONS;
        i++
    ) {
        long http_status = 0;
        long os_errno = 0;

        curl_easy_getinfo(
            tests[i].easy,
            CURLINFO_RESPONSE_CODE,
            &http_status
        );

        curl_easy_getinfo(
            tests[i].easy,
            CURLINFO_OS_ERRNO,
            &os_errno
        );

        total_bytes +=
            tests[i].progress.bytes;

        if (
            results[i] != CURLE_OK ||
            http_status != 200
        ) {
            if (success) {
                snprintf(
                    error,
                    error_size,

                    "Connection %d failed: "
                    "curl=%d (%s), "
                    "HTTP=%ld, errno=%ld",

                    i + 1,
                    (int)results[i],
                    curl_easy_strerror(
                        results[i]
                    ),
                    http_status,
                    os_errno
                );
            }

            success = false;
        }
    }

    for (
        int i = 0;
        i < CONNECTIONS;
        i++
    ) {
        curl_multi_remove_handle(
            multi,
            tests[i].easy
        );

        curl_easy_cleanup(
            tests[i].easy
        );
    }

    curl_multi_cleanup(
        multi
    );

    if (!success)
        return false;

    double seconds =
        elapsed_seconds(
            &start,
            &end
        );

    if (seconds <= 0.0) {
        snprintf(
            error,
            error_size,
            "Invalid timing result."
        );

        return false;
    }

    if (bytes_tested)
        *bytes_tested =
            total_bytes;

    if (mb_per_second) {
        *mb_per_second =
            (
                (double)total_bytes /
                1048576.0
            ) /
            seconds;
    }

    return true;
}




typedef struct {
    CURL *easy;
    NetworkDiagContext progress;
    char range[64];
    unsigned long long expected_bytes;
    bool added;
    CURLcode result;
} RawUrlParallelTest;


static size_t network_diag_capped_write(
    char *ptr,
    size_t size,
    size_t nmemb,
    void *userdata
)
{
    (void)ptr;

    NetworkDiagContext *ctx =
        (NetworkDiagContext *)userdata;

    size_t amount =
        size * nmemb;

    if (
        ctx->bytes +
            (unsigned long long)amount >
        ctx->limit
    ) {
        return 0;
    }

    ctx->bytes +=
        (unsigned long long)amount;

    return amount;
}


static bool raw_url_parallel_once(
    const char *direct_url,
    int streams,
    double *mb_per_second,
    unsigned long long *bytes_tested,
    char *error,
    size_t error_size
)
{
    enum {
        MAX_STREAMS = 5
    };

    const unsigned long long total_bytes =
        64ULL * 1024ULL * 1024ULL;

    if (
        streams < 1 ||
        streams > MAX_STREAMS
    ) {
        snprintf(
            error,
            error_size,
            "Invalid stream count: %d",
            streams
        );

        return false;
    }

    RawUrlParallelTest tests[MAX_STREAMS];

    memset(
        tests,
        0,
        sizeof(tests)
    );

    CURLM *multi =
        curl_multi_init();

    if (!multi) {
        snprintf(
            error,
            error_size,
            "curl_multi_init failed"
        );

        return false;
    }

    curl_multi_setopt(
        multi,
        CURLMOPT_MAX_HOST_CONNECTIONS,
        (long)streams
    );

    curl_multi_setopt(
        multi,
        CURLMOPT_MAX_TOTAL_CONNECTIONS,
        (long)streams
    );

    unsigned long long cursor = 0;
    const unsigned long long base =
        total_bytes /
        (unsigned long long)streams;
    const unsigned long long remainder =
        total_bytes %
        (unsigned long long)streams;

    bool setup_ok = true;

    for (
        int i = 0;
        i < streams;
        i++
    ) {
        unsigned long long length =
            base +
            (
                (unsigned long long)i <
                remainder
                    ? 1ULL
                    : 0ULL
            );

        unsigned long long first =
            cursor;
        unsigned long long last =
            first +
            length -
            1ULL;

        cursor += length;

        snprintf(
            tests[i].range,
            sizeof(tests[i].range),
            "%llu-%llu",
            first,
            last
        );

        tests[i].expected_bytes =
            length;
        tests[i].progress.bytes = 0;
        tests[i].progress.limit =
            length;
        tests[i].result =
            CURLE_FAILED_INIT;

        tests[i].easy =
            curl_easy_init();

        if (!tests[i].easy) {
            setup_ok = false;
            break;
        }

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_URL,
            direct_url
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_RANGE,
            tests[i].range
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_WRITEFUNCTION,
            network_diag_capped_write
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_WRITEDATA,
            &tests[i].progress
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_FOLLOWLOCATION,
            1L
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_MAXREDIRS,
            10L
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_BUFFERSIZE,
            512L * 1024L
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_CONNECTTIMEOUT,
            30L
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_TIMEOUT,
            180L
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_NOSIGNAL,
            1L
        );

        /*
         * Diagnostic build: the project-local
         * mbedTLS 2.16 stack has no Switch CA-store bridge.
         */
        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_SSL_VERIFYPEER,
            0L
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_SSL_VERIFYHOST,
            0L
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_USERAGENT,
            "Mozilla/5.0 (Windows NT 6.1; WOW64) "
            "AppleWebKit/537.36 (KHTML, like Gecko) "
            "Chrome/51.0.2704.85 Safari/537.37"
        );

        /*
         * Force each range onto its own TCP connection.
         * This diagnostic is measuring connection parallelism,
         * not libcurl connection reuse.
         */
        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_FRESH_CONNECT,
            1L
        );

        curl_easy_setopt(
            tests[i].easy,
            CURLOPT_FORBID_REUSE,
            1L
        );

        CURLMcode add_rc =
            curl_multi_add_handle(
                multi,
                tests[i].easy
            );

        if (add_rc != CURLM_OK) {
            setup_ok = false;
            break;
        }

        tests[i].added = true;
    }

    if (!setup_ok) {
        for (
            int i = 0;
            i < streams;
            i++
        ) {
            if (
                tests[i].easy &&
                tests[i].added
            ) {
                curl_multi_remove_handle(
                    multi,
                    tests[i].easy
                );
            }

            if (tests[i].easy) {
                curl_easy_cleanup(
                    tests[i].easy
                );
            }
        }

        curl_multi_cleanup(
            multi
        );

        snprintf(
            error,
            error_size,
            "Could not prepare %d-stream test",
            streams
        );

        return false;
    }

    struct timespec start;
    struct timespec end;

    clock_gettime(
        CLOCK_MONOTONIC,
        &start
    );

    int running = 0;

    CURLMcode mrc =
        curl_multi_perform(
            multi,
            &running
        );

    while (
        mrc == CURLM_OK &&
        running > 0
    ) {
        int numfds = 0;

        mrc =
            curl_multi_wait(
                multi,
                NULL,
                0,
                1000,
                &numfds
            );

        if (mrc != CURLM_OK)
            break;

        mrc =
            curl_multi_perform(
                multi,
                &running
            );
    }

    clock_gettime(
        CLOCK_MONOTONIC,
        &end
    );

    int messages_left = 0;
    CURLMsg *msg = NULL;

    while (
        (
            msg =
                curl_multi_info_read(
                    multi,
                    &messages_left
                )
        ) != NULL
    ) {
        if (
            msg->msg !=
            CURLMSG_DONE
        ) {
            continue;
        }

        for (
            int i = 0;
            i < streams;
            i++
        ) {
            if (
                tests[i].easy ==
                msg->easy_handle
            ) {
                tests[i].result =
                    msg->data.result;
                break;
            }
        }
    }

    bool success =
        mrc == CURLM_OK;

    if (!success) {
        snprintf(
            error,
            error_size,
            "curl multi error in %d-stream test: %s",
            streams,
            curl_multi_strerror(mrc)
        );
    }

    unsigned long long total_received = 0;

    for (
        int i = 0;
        i < streams;
        i++
    ) {
        long http_status = 0;
        long os_errno = 0;

        curl_easy_getinfo(
            tests[i].easy,
            CURLINFO_RESPONSE_CODE,
            &http_status
        );

        curl_easy_getinfo(
            tests[i].easy,
            CURLINFO_OS_ERRNO,
            &os_errno
        );

        total_received +=
            tests[i].progress.bytes;

        if (
            tests[i].result != CURLE_OK ||
            http_status != 206 ||
            tests[i].progress.bytes !=
                tests[i].expected_bytes
        ) {
            if (success) {
                snprintf(
                    error,
                    error_size,
                    "%d-stream connection %d failed: "
                    "curl=%d (%s), HTTP=%ld, errno=%ld, "
                    "bytes=%llu/%llu",
                    streams,
                    i + 1,
                    (int)tests[i].result,
                    curl_easy_strerror(
                        tests[i].result
                    ),
                    http_status,
                    os_errno,
                    tests[i].progress.bytes,
                    tests[i].expected_bytes
                );
            }

            success = false;
        }
    }

    for (
        int i = 0;
        i < streams;
        i++
    ) {
        if (
            tests[i].easy &&
            tests[i].added
        ) {
            curl_multi_remove_handle(
                multi,
                tests[i].easy
            );
        }

        if (tests[i].easy) {
            curl_easy_cleanup(
                tests[i].easy
            );
        }
    }

    curl_multi_cleanup(
        multi
    );

    if (!success)
        return false;

    double seconds =
        elapsed_seconds(
            &start,
            &end
        );

    if (seconds <= 0.0) {
        snprintf(
            error,
            error_size,
            "Invalid timing result for %d streams",
            streams
        );

        return false;
    }

    if (bytes_tested)
        *bytes_tested =
            total_received;

    if (mb_per_second) {
        *mb_per_second =
            (
                (double)total_received /
                1048576.0
            ) /
            seconds;
    }

    return true;
}


bool downloader_debug_raw_url_parallel_sweep(
    const char *direct_url,
    double speeds[5],
    unsigned long long bytes_tested[5],
    int *failed_stream_count,
    char *error,
    size_t error_size
)
{
    if (failed_stream_count)
        *failed_stream_count = 0;

    if (
        !direct_url ||
        (
            strncmp(
                direct_url,
                "https://",
                8
            ) != 0 &&
            strncmp(
                direct_url,
                "http://",
                7
            ) != 0
        )
    ) {
        snprintf(
            error,
            error_size,
            "Paste a valid direct HTTP/HTTPS URL"
        );

        return false;
    }

    DownloaderStats stats;

    downloader_get_stats(
        &stats
    );

    if (
        stats.active > 0 ||
        stats.queued > 0
    ) {
        snprintf(
            error,
            error_size,
            "Wait for normal downloads to finish first"
        );

        return false;
    }

    for (int i = 0; i < 5; i++) {
        speeds[i] = 0.0;
        bytes_tested[i] = 0;
    }

    /*
     * Test 1:
     * one connection, 64 MiB total.
     */
    if (
        !raw_url_parallel_once(
            direct_url,
            1,
            &speeds[0],
            &bytes_tested[0],
            error,
            error_size
        )
    ) {
        if (failed_stream_count)
            *failed_stream_count = 1;

        return false;
    }

    /*
     * Test 2:
     * three independent ranged connections,
     * still only 64 MiB aggregate.
     */
    if (
        !raw_url_parallel_once(
            direct_url,
            3,
            &speeds[1],
            &bytes_tested[1],
            error,
            error_size
        )
    ) {
        if (failed_stream_count)
            *failed_stream_count = 3;

        return false;
    }

    return true;
}


bool downloader_debug_raw_url(
    const char *direct_url,
    double *mb_per_second,
    unsigned long long *bytes_tested,
    char *error,
    size_t error_size
)
{
    if (mb_per_second)
        *mb_per_second = 0.0;

    if (bytes_tested)
        *bytes_tested = 0;

    if (
        !direct_url ||
        (
            strncmp(
                direct_url,
                "https://",
                8
            ) != 0 &&
            strncmp(
                direct_url,
                "http://",
                7
            ) != 0
        )
    ) {
        snprintf(
            error,
            error_size,
            "Paste a valid direct HTTP/HTTPS URL."
        );

        return false;
    }

    DownloaderStats stats;

    downloader_get_stats(
        &stats
    );

    if (
        stats.active > 0 ||
        stats.queued > 0
    ) {
        snprintf(
            error,
            error_size,
            "Wait for normal downloads to finish first."
        );

        return false;
    }

    CURL *curl =
        curl_easy_init();

    if (!curl) {
        snprintf(
            error,
            error_size,
            "curl_easy_init failed."
        );

        return false;
    }

    /*
     * Normal full GET.
     *
     * No Range header.
     * Stop after 64 MiB so a multi-GB file is not
     * downloaded just for the benchmark.
     */
    NetworkDiagContext ctx = {
        .bytes = 0,
        .limit =
            64ULL *
            1024ULL *
            1024ULL
    };

    curl_easy_setopt(
        curl,
        CURLOPT_URL,
        direct_url
    );

    curl_easy_setopt(
        curl,
        CURLOPT_FOLLOWLOCATION,
        1L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_MAXREDIRS,
        10L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_WRITEFUNCTION,
        network_diag_write
    );

    curl_easy_setopt(
        curl,
        CURLOPT_WRITEDATA,
        &ctx
    );

    /*
     * Abort deliberately after 64 MiB.
     */
    curl_easy_setopt(
        curl,
        CURLOPT_XFERINFOFUNCTION,
        network_diag_progress
    );

    curl_easy_setopt(
        curl,
        CURLOPT_XFERINFODATA,
        &ctx
    );

    curl_easy_setopt(
        curl,
        CURLOPT_NOPROGRESS,
        0L
    );

    /*
     * Tinfoil-confirmed libcurl receive buffer.
     */
    curl_easy_setopt(
        curl,
        CURLOPT_BUFFERSIZE,
        512L * 1024L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_CONNECTTIMEOUT,
        30L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_TIMEOUT,
        180L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_NOSIGNAL,
        1L
    );

    /*
     * Benchmark build only.
     *
     * Our old mbedTLS 2.16 test build does not have
     * Nintendo's CA-store integration.
     */
    curl_easy_setopt(
        curl,
        CURLOPT_SSL_VERIFYPEER,
        0L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_SSL_VERIFYHOST,
        0L
    );

    curl_easy_setopt(
        curl,
        CURLOPT_USERAGENT,
        "Mozilla/5.0 (Windows NT 6.1; WOW64) "
        "AppleWebKit/537.36 (KHTML, like Gecko) "
        "Chrome/51.0.2704.85 Safari/537.37"
    );

    /*
     * IMPORTANT:
     *
     * No CURLOPT_HTTP_VERSION.
     * No CURLOPT_RANGE.
     * No SD writes.
     * No AllDebrid unlock here.
     *
     * The supplied URL is tested exactly as supplied.
     */

    struct timespec start;
    struct timespec end;

    clock_gettime(
        CLOCK_MONOTONIC,
        &start
    );

    CURLcode rc =
        curl_easy_perform(
            curl
        );

    clock_gettime(
        CLOCK_MONOTONIC,
        &end
    );

    long http_status = 0;

    curl_easy_getinfo(
        curl,
        CURLINFO_RESPONSE_CODE,
        &http_status
    );

    curl_easy_cleanup(
        curl
    );

    bool intentionally_stopped =
        (
            rc ==
            CURLE_ABORTED_BY_CALLBACK
        ) &&
        (
            ctx.bytes >=
            ctx.limit
        );

    if (
        rc != CURLE_OK &&
        !intentionally_stopped
    ) {
        snprintf(
            error,
            error_size,
            "curl=%d HTTP=%ld",
            (int)rc,
            http_status
        );

        return false;
    }

    if (
        http_status != 200 &&
        http_status != 206
    ) {
        snprintf(
            error,
            error_size,
            "HTTP %ld",
            http_status
        );

        return false;
    }

    double seconds =
        elapsed_seconds(
            &start,
            &end
        );

    if (seconds <= 0.0) {
        snprintf(
            error,
            error_size,
            "Invalid timing result."
        );

        return false;
    }

    if (bytes_tested)
        *bytes_tested =
            ctx.bytes;

    if (mb_per_second) {
        *mb_per_second =
            (
                (double)ctx.bytes /
                1048576.0
            ) /
            seconds;
    }

    return true;
}


