/* Queue                                                     */
/* ========================================================= */

static char *pop_job(void)
{
    mutexLock(
        &g_mutex
    );

    if (
        g_queue.count <= 0
    ) {
        mutexUnlock(
            &g_mutex
        );

        return NULL;
    }

    char *job =
        g_queue.items[
            g_queue.head
        ];

    g_queue.items[
        g_queue.head
    ] = NULL;

    g_queue.head =
        (
            g_queue.head +
            1
        ) %
        MAX_QUEUE;

    g_queue.count--;

    mutexUnlock(
        &g_mutex
    );

    return job;
}


void downloader_set_token(
    const char *token
)
{
    mutexLock(
        &g_mutex
    );

    snprintf(
        g_token,
        sizeof(g_token),
        "%s",
        token ? token : ""
    );

    mutexUnlock(
        &g_mutex
    );
}


static bool downloader_enqueue_mode(
    const char *url,
    char mode
)
{
    if (
        !url ||
        !url[0]
    ) {
        return false;
    }

    size_t len =
        strlen(url);

    char *copy =
        malloc(
            len + 3
        );

    if (!copy)
        return false;

    copy[0] = mode;
    copy[1] = '\t';

    memcpy(
        copy + 2,
        url,
        len + 1
    );

    mutexLock(
        &g_mutex
    );

    if (
        g_queue.count >=
        MAX_QUEUE
    ) {
        mutexUnlock(
            &g_mutex
        );

        free(copy);

        return false;
    }

    g_queue.items[
        g_queue.tail
    ] = copy;

    g_queue.tail =
        (
            g_queue.tail +
            1
        ) %
        MAX_QUEUE;

    g_queue.count++;

    mutexUnlock(
        &g_mutex
    );

    return true;
}


bool downloader_enqueue_direct(
    const char *url
)
{
    return
        downloader_enqueue_mode(
            url,
            'D'
        );
}


bool downloader_enqueue_alldebrid(
    const char *url
)
{
    return
        downloader_enqueue_mode(
            url,
            'A'
        );
}


bool downloader_enqueue(
    const char *url
)
{
    return
        downloader_enqueue_alldebrid(
            url
        );
}


